package com.dakshabhi.orders.dao;

import java.sql.ResultSet;
import java.util.ArrayList;import com.ctc.wstx.util.StringUtil;
import com.dakshabhi.common.db.QueryHelper;
import com.dakshabhi.common.utility.StringUtility;
import com.dakshabhi.orders.dto.OrderDTO;

public class OrderDAO {

	public static ArrayList<OrderDTO> getOrderList(String searchKeyword, String fromDate, String toDate,
			String orderStatus) {

		ArrayList<OrderDTO> orderList = new ArrayList<OrderDTO>(); 
		QueryHelper qh = new QueryHelper();

		try {
			String subQuery = "";

			if (orderStatus != null && !orderStatus.trim().isEmpty()) {
			    subQuery += " and order_status = ?";
			    qh.addParam(orderStatus.trim());
			}

			if (searchKeyword != null && !searchKeyword.trim().isEmpty()) {
				searchKeyword = "%" + searchKeyword.trim() + "%";
				subQuery += " and (email LIKE ? or first_name LIKE ? or last_name LIKE ?)";
				qh.addParam(searchKeyword);
				qh.addParam(searchKeyword);
				qh.addParam(searchKeyword);
			}

			String sql = "select * from qa_order where 1=1 " + subQuery
					+ " and date_created >= ? and date_created <= ? order by id desc";

			qh.addParam(fromDate);
			qh.addParam(toDate);

			ResultSet rs = qh.runQueryStreamResults(sql);

			while (rs.next()) {
				OrderDTO orderDTO = new OrderDTO();
				orderDTO.setOrderId(rs.getString("id"));
				orderDTO.setDateCreated(rs.getString("date_created"));
				orderDTO.setTimeCreated(rs.getString("time_created"));
				orderDTO.setFirstName(rs.getString("first_name"));
				orderDTO.setLastName(rs.getString("last_name"));
				orderDTO.setEmail(rs.getString("email"));
				orderDTO.setPhone(rs.getString("phone_no"));
				orderDTO.setPaymentId("");
				if (rs.getInt("order_status") == 1) {
					orderDTO.setPaymentId(getPaymentID(rs.getInt("id")));
				}
				orderDTO.setShippingMethod(StringUtility.removeNull(rs.getString("shipping_method")));
				orderDTO.setShippingCost(String.format("%.2f", rs.getDouble("shipping_cost")));
				orderDTO.setDocumentName(StringUtility.removeNull(rs.getString("document_name")));
				orderDTO.setAdditionalServices(getAdditionalService(rs.getString("id")));
				orderDTO.setOrderStatus(rs.getString("order_status"));
				orderDTO.setCurrencyCode(StringUtility.removeNull(rs.getString("currency_code")));
				orderDTO.setCountry(StringUtility.removeNull(rs.getString("country")));
				orderDTO.setTotalCost(String.format("%.2f", rs.getDouble("order_total_amount")));
				orderDTO.setUserIP(StringUtility.removeNull(rs.getString("user_ip")));
				orderList.add(orderDTO);
			}
		} catch (Exception e) {
			e.printStackTrace();
		} finally {
			qh.releaseConnection();
		}

		return orderList;
	}
	private static String getPaymentID(int orderID) {
		QueryHelper qh = new QueryHelper(); 
		try {
			String sql = "select * from qa_order_payment where order_id = ?";
			qh.addParam(orderID);
			ResultSet rs = qh.runQueryStreamResults(sql);
			
			if(rs.next()) {
				return  rs.getString("payment_id");
			}
		} catch (Exception e) {
			e.printStackTrace();
		}finally {
			qh.releaseConnection();
		}
		return "";
	}

	private static String getAdditionalService(String orderID) {
		QueryHelper qh = new QueryHelper();
		String services = "";
		try {
			String sql = "select * from qa_order_products where order_id = ?";
			qh.addParam(orderID);
			ResultSet rs = qh.runQueryStreamResults(sql);
			
			while(rs.next()) {
				services += rs.getString("prodcut_name") + "<br/>";
			}
		} catch (Exception e) {
			e.printStackTrace();
		}finally {
			qh.releaseConnection();
		}
		
		return services;
	}
	public static OrderDTO getOrderById(String orderId) {
		QueryHelper qh = new QueryHelper();
		OrderDTO orderDTO = null;
		try {
			String sql = "SELECT * FROM qa_order WHERE id = ?";
			qh.addParam(orderId);
			ResultSet rs = qh.runQueryStreamResults(sql);

			if (rs.next()) {
				orderDTO = new OrderDTO();
				orderDTO.setOrderId(rs.getString("id"));
				orderDTO.setDateCreated(rs.getString("date_created"));
				orderDTO.setTimeCreated(rs.getString("time_created"));
				orderDTO.setFirstName(rs.getString("first_name"));
				orderDTO.setLastName(rs.getString("last_name"));
				orderDTO.setEmail(rs.getString("email"));
				orderDTO.setPhone(rs.getString("phone_no"));
				orderDTO.setCountry(rs.getString("country"));
				orderDTO.setUserIP(rs.getString("user_ip"));
				orderDTO.setShippingMethod(StringUtility.removeNull(rs.getString("shipping_method")));
				orderDTO.setShippingCost(String.format("%.2f", rs.getDouble("shipping_cost")));
				orderDTO.setDocumentName(StringUtility.removeNull(rs.getString("document_name")));
				orderDTO.setAdditionalServices(getAdditionalService(orderId));
				orderDTO.setOrderStatus(rs.getString("order_status"));
				orderDTO.setPaymentId(getPaymentID(Integer.parseInt(orderId)));
			}
		} catch (Exception e) {
			e.printStackTrace();
		} finally {
			qh.releaseConnection();
		}
		return orderDTO;
	}
	public static boolean updateOrder(OrderDTO order) {
		QueryHelper qh = new QueryHelper();
		try {
			String sql = "UPDATE qa_order SET first_name = ?,last_name =?,phone_no =?, order_status = ? WHERE id = ?";
			qh.addParam(order.getFirstName());
			qh.addParam(order.getLastName());
			qh.addParam(order.getPhone());
			qh.addParam(order.getOrderStatus());
			qh.addParam(order.getOrderId());
			qh.runQuery(sql);
		
		} catch (Exception e) {
			e.printStackTrace();
			return false;
		} finally {
			qh.releaseConnection();
		}
		return false;
	}


}

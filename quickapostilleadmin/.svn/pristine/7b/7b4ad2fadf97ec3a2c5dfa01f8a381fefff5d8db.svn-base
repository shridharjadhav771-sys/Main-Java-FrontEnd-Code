public class OrderDAO {

	public static ArrayList<OrderDTO> getOrderList(String searchKeyword, String fromDate, String toDate,
			String orderStatus) {

		ArrayList<OrderDTO> orderList = new ArrayList<OrderDTO>(); 
		QueryHelper qh = new QueryHelper();

		try {
			String subQuery = "";

			if (orderStatus != null && !orderStatus.trim().isEmpty()) {
			    subQuery += " and order_status = ?";
			    qh.addParam(orderStatus.trim());
			}

			if (searchKeyword != null && !searchKeyword.trim().isEmpty()) {
				searchKeyword = "%" + searchKeyword.trim() + "%";
				subQuery += " and (email LIKE ? or first_name LIKE ? or last_name LIKE ?)";
				qh.addParam(searchKeyword);
				qh.addParam(searchKeyword);
				qh.addParam(searchKeyword);
			}

			String sql = "select * from qa_order where is_deleted = 0 " + subQuery
					+ " and date_created >= ? and date_created <= ? order by id desc";

			qh.addParam(fromDate);
			qh.addParam(toDate);

			ResultSet rs = qh.runQueryStreamResults(sql);

			while (rs.next()) {
				OrderDTO orderDTO = new OrderDTO();
				orderDTO.setOrderId(rs.getString("id"));
				orderDTO.setDateCreated(rs.getString("date_created"));
				orderDTO.setTimeCreated(rs.getString("time_created"));
				orderDTO.setFirstName(rs.getString("first_name"));
				orderDTO.setLastName(rs.getString("last_name"));
				orderDTO.setEmail(rs.getString("email"));
				orderDTO.setPhone(rs.getString("phone_no"));
				orderDTO.setPaymentId("");
				if (rs.getInt("order_status") == 1) {
					orderDTO.setPaymentId(getPaymentID(rs.getInt("id")));
				}
				orderDTO.setShippingMethod(StringUtility.removeNull(rs.getString("shipping_method")));
				orderDTO.setShippingCost(String.format("%.2f", rs.getDouble("shipping_cost")));
				orderDTO.setDocumentName(StringUtility.removeNull(rs.getString("document_name")));
				orderDTO.setDocumentList(getDocmentList(rs.getInt("id")));
				orderDTO.setAdditionalServices(getAdditionalService(rs.getString("id")));
				orderDTO.setOrderStatus(rs.getString("order_status"));
				orderDTO.setCurrencyCode(StringUtility.removeNull(rs.getString("currency_code")));
				orderDTO.setCountry(getCountryFullName(StringUtility.removeNull(rs.getString("country"))));
				orderDTO.setTotalCost(String.format("%.2f", rs.getDouble("order_total_amount")));
				orderDTO.setUserIP(StringUtility.removeNull(rs.getString("user_ip")));
				orderDTO.setNotes(StringUtility.removeNull(rs.getString("notes")));
				orderList.add(orderDTO);
			}
		} catch (Exception e) {
			e.printStackTrace();
		} finally {
			qh.releaseConnection();
		}

		return orderList;
	}
	

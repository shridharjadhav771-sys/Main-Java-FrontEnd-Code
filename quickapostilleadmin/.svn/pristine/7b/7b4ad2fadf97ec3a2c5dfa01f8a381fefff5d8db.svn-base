	private static List<String> getDocmentList(int id) {
		List<String> dList = new ArrayList<String>();
		QueryHelper qh = new QueryHelper();
		try {
			String sql = "select * from qa_order_documents where order_id = ?";
			qh.addParam(id);
			ResultSet rs = qh.runQueryStreamResults(sql);
			while(rs.next()) {
				dList.add(StringUtility.removeNull(rs.getString("document_name")));
			}
		} catch (Exception e) {
			e.printStackTrace();
		}finally {
			qh.releaseConnection();
		}
		return dList;
	}
	private static String getPaymentID(int orderID) {
		QueryHelper qh = new QueryHelper(); 
		try {
			String sql = "select * from qa_order_payment where order_id = ?";
			qh.addParam(orderID);
			ResultSet rs = qh.runQueryStreamResults(sql);
			
			if(rs.next()) {
				return  rs.getString("payment_id");
			}
		} catch (Exception e) {
			e.printStackTrace();
		}finally {
			qh.releaseConnection();
		}
		return "";
	}

	private static String getAdditionalService(String orderID) {
		QueryHelper qh = new QueryHelper();
		String services = "";
		try {
			String sql = "select * from qa_order_products where order_id = ?";
			qh.addParam(orderID);
			ResultSet rs = qh.runQueryStreamResults(sql);
			
			while(rs.next()) {
				services += rs.getString("prodcut_name") + "(" + rs.getString("product_quantity") + ")<br/>";
			}
		} catch (Exception e) {
			e.printStackTrace();
		}finally {
			qh.releaseConnection();
		}
		
		return services;
	}
	public OrderDTO getOrderDetails(int id){
		QueryHelper qh = new QueryHelper();
		OrderDTO orderDTO = new OrderDTO();
		try {
			String sql = "select qo.*,qi.item_name from qa_order qo left join qa_items qi on qo.product_id = qi.item_id  where qo.is_deleted = 0 and qo.id = "+ id;
			ResultSet rs = qh.runQueryStreamResults(sql);
			if (rs.next()) {	
				orderDTO.setOrderId(rs.getString("id"));
				orderDTO.setDateCreated(rs.getString("date_created"));
				orderDTO.setTimeCreated(rs.getString("time_created"));
				orderDTO.setFirstName(rs.getString("first_name"));
				orderDTO.setLastName(rs.getString("last_name"));
				orderDTO.setEmail(rs.getString("email"));
				orderDTO.setPhone(rs.getString("phone_no"));
				orderDTO.setShippingMethod(StringUtility.removeNull(rs.getString("shipping_method")));
				orderDTO.setShippingCost(String.format("%.2f", rs.getDouble("shipping_cost")));
				orderDTO.setDocumentName(StringUtility.removeNull(rs.getString("document_name")));
				orderDTO.setDocumentList(getDocmentList(rs.getInt("id")));
				orderDTO.setAdditionalServices(getAdditionalService(rs.getString("id")));
				orderDTO.setOrderStatus(rs.getString("order_status"));
				orderDTO.setCurrencyCode(StringUtility.removeNull(rs.getString("currency_code")));
				orderDTO.setCountry(StringUtility.removeNull(rs.getString("country")));
				orderDTO.setTotalCost(String.format("%.2f", rs.getDouble("order_total_amount")));
				orderDTO.setUserIP(StringUtility.removeNull(rs.getString("user_ip")));
				orderDTO.setNotes(StringUtility.removeNull(rs.getString("notes")));
				orderDTO.setProduct(rs.getString("item_name"));
				orderDTO.setQuantity(rs.getInt("quantity"));
				orderDTO.setSessionId(rs.getString("session_id"));
				orderDTO.setProduct_price(rs.getDouble("product_price"));
				return orderDTO;
			}
		} catch (Exception e) {
			e.printStackTrace();
		}finally {
			qh.releaseConnection();
		}
		return orderDTO;
	}

	public ArrayList<CustomerOrderProductDto> getAddonsList(int id) {
		QueryHelper qh = new QueryHelper();
		ArrayList<CustomerOrderProductDto> services = new ArrayList<>();
		try {
			String sql = "select * from qa_order_products where order_id = ?";
			qh.addParam(id);
			ResultSet rs = qh.runQueryStreamResults(sql);			
			while(rs.next()) {
				CustomerOrderProductDto productDto = new CustomerOrderProductDto();
				productDto.setProduct_name(rs.getString("prodcut_name"));
				productDto.setProduct_price(rs.getDouble("product_price"));
				productDto.setProduct_quantity(rs.getInt("product_quantity"));
				services.add(productDto);
			}
		} catch (Exception e) {
			e.printStackTrace();
		}finally {
			qh.releaseConnection();
		}
		return services;
	}
	public ArrayList<AddonsDTO> getAddonsPrice() {
		QueryHelper qh = new QueryHelper();
		ArrayList<AddonsDTO> list = new ArrayList<>();
		try {
			String sql = "SELECT * FROM qa_addons WHERE is_deleted = 0";
			ResultSet rs = qh .runQueryStreamResults(sql);
			while(rs.next()) {
				AddonsDTO dto = new AddonsDTO();
				dto.setId(rs.getInt("id"));
				dto.setAddon_name(rs.getString("name"));
				dto.setDefault_price(rs.getDouble("default_price"));
				dto.setUs_price(rs.getDouble("us_price"));
				dto.setGbp_price(rs.getDouble("gbp_price"));
				dto.setUae_price(rs.getDouble("uae_price"));
				dto.setEuro_price(rs.getDouble("euro_price"));
				list.add(dto);
			}			
		} catch (Exception e) {
			e.printStackTrace();
		}finally {
			qh.releaseConnection();
		}
		return list;
	}

	public void updateAddons(int orderId, String[] addonValues, int addonquantity1, int addonquantity2, int addonquantity3, int addonquantity4) {
		QueryHelper qh = new QueryHelper();
		try {
			String deleteSql = "DELETE FROM qa_order_products WHERE order_id = ? AND product_id = 0";
			qh.addParam(orderId);
			qh.runQuery(deleteSql);
			qh.releaseConnection();
		} catch (Exception e) {
			e.printStackTrace();
			qh.releaseConnection();
		}
		if(addonValues != null) {
			for (String addon : addonValues) {
				String[] parts = addon.split("::");
				if (parts.length == 2) {
					int quantity = 1;
					String addonName = parts[0];
					if(addonName.equalsIgnoreCase("Add Notarization")) {
						quantity = addonquantity1;
					}else if(addonName.equalsIgnoreCase("Add Translation")) {
						quantity = addonquantity2;
					}else if(addonName.equalsIgnoreCase("Add Certified Copy of Passport/ID")) {
						quantity = addonquantity3;
					}else if(addonName.equalsIgnoreCase("Express Service")){
						quantity = addonquantity4;
					}
					double addonPrice = Double.parseDouble(parts[1]);			
					QueryHelper insertQh = new QueryHelper();
					try {
						String insertSql = "INSERT INTO qa_order_products (order_id, product_id, prodcut_name, product_price, product_quantity) VALUES (?, ?, ?, ?, ?)";
						insertQh.addParam(orderId);
						insertQh.addParam(0);
						insertQh.addParam(addonName);
						insertQh.addParam(addonPrice);
						insertQh.addParam(quantity);
						insertQh.runQuery(insertSql);
					} catch (Exception e) {
						e.printStackTrace();
					} finally {
						insertQh.releaseConnection();
					}
				}
			}
		}
		
		
	}

	public boolean updateOrderDetails(OrderDTO orderDTO) {
		QueryHelper qh = new QueryHelper();
		try {
			String sql = "UPDATE qa_order SET order_total_amount=?, shipping_method=?, shipping_cost=?, quantity=? WHERE id=?";
			qh.addParam(orderDTO.getTotalCost());
			qh.addParam(orderDTO.getShippingMethod());
			qh.addParam(orderDTO.getShippingCost());
			qh.addParam(orderDTO.getQuantity());
			qh.addParam(orderDTO.getOrderId());
			qh.runQuery(sql);
			return true;
			
		} catch (Exception e) {
			e.printStackTrace();
		} finally {
			qh.releaseConnection();
		}
		return false;
	}

}

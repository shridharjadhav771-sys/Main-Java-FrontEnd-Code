<script src="https://ajax.googleapis.com/ajax/libs/jquery/1.7.1/jquery.min.js" type="text/javascript"></script>
<script type="text/javascript">
	const productData = {
	  <% for (Map.Entry<Integer, ProductServiceDTO> entry : productMap.entrySet()) { %>
	    "<%= entry.getKey() %>": {
	      "USD": "<%= entry.getValue().getItem_us_price() %>",
	      "AED": "<%= entry.getValue().getItem_uae_price() %>",
	      "GBP": "<%= entry.getValue().getItem_gbp_price() %>",
	      "EUR": "<%= entry.getValue().getItem_euro_price() %>"
	    },
	  <% } %>
	};

	$(function() {
		
		$.get("https://ipinfo.io", function(response) {
		    var country = response.country;
		    let currencySymbol = "\u0024";
		    let currencyCode = "USD";
		    let priceKey = "USD";

		    if (country === 'AE') {
		    	currencySymbol = "AED ";
				currencyCode = "AED";
		        priceKey = "AED";
		    } else if (country === 'GB') {
		    	currencySymbol = "\u00A3";
				currencyCode = "GBP";
		        priceKey = "GBP";
		    } else if (country !== '' && country !== 'US' && country !== 'IN') {
		    	currencySymbol = "\u20AC";
				currencyCode = "EUR";
		        priceKey = "EUR";
		    }

		    $('p.product-sections-inside-p').each(function () {
		        let key = $(this).attr("data-key");
		        if (productData[key]) {
		            $(this).text(currencySymbol + productData[key][priceKey]);
		        }
		    });
		}, "jsonp");
	
	});

</script>

	<script type="text/javascript">
		$(document).ready(function() {
			$("#get-started-button").hover(function() {
				$(this).css({
					"background-color" : "#f2d299"
				});
			}, function() {
				$(this).css({
					"background-color" : "#0067ff"
				});
			});
		});

		$(document).ready(
				function() {

					// Close all open answers and reset icons on load
					$(".answer").css("display", "none");
					$("#ans1").slideDown("slow");
					$(".question").click(
							function() {

								const answer = $(this).find(".answer");

								if (answer.is(":hidden")) {
									// Close all open answers and reset icons
									$(".answer").slideUp("slow");
									$("i").removeClass("fa-minus").addClass(
											"fa-plus");

									// Open the selected answer and update icon
									answer.slideDown("slow");
									$(this).find("i").removeClass("fa-plus")
											.addClass("fa-minus");
								} else {
									// Close the selected answer and reset icon
									answer.slideUp("slow");
									$(this).find("i").removeClass("fa-minus")
											.addClass("fa-plus");
								}

							});

				});
	</script>

				<div class="col-md-3"></div>
			</div> 
			<div class="row">

				<div class="col-md-7 com-sm-12">
					<div class="d-flex justify-content-between">
						<h2>Apostille</h2>
						<!-- <h3>
							Price: <span class="currencySymbol"></span>95.00
						</h3> -->
					</div>
					<p class="mt-4">With Quick Apostille, you can securely have your important documents notarized by a licensed notary and apostilled from the comfort of your home or office.</p>
					<u><h4>How it works</h4></u>
					<ul class="mt-4">
						<li>Upload your document(s)</li>
						<li>Complete your Identity Verification online</li>
						<li>Get your document(s) with Apostille by email (and via
							Registered Mail/Courier if required)</li>
					</ul>
					 
					<ul class="fw-bold">
						<li>Get Your Documents Officially Apostilled.</li>
						<li>Quick 24 Hour Turnaround.</li>
						<li>Works For Any Country.</li>
						<li>Official HCCH Hague Convention Compliance.</li>
					</ul>
					 
				</div>
				<div class="col-md-5 col-sm-12 order-1">
					<img id="coverImage" fetchpriority="high" alt="apostille" src="images/Cover-image.webp"
						class="w-100">
				</div>
			</div>
			<div class="horizontalLine"></div>
			
				<%
							CustomerOrderDTO orderDTO = (CustomerOrderDTO) request.getSession().getAttribute("orderDTO");
							List<CustomerOrderProductDto> list = (ArrayList<CustomerOrderProductDto>) request.getSession()
									.getAttribute("addonList");
							if (orderDTO != null) {
							%>
						<script>
							document.addEventListener("DOMContentLoaded", function () {
								document.getElementById("userIp").value = "<%=orderDTO.getUserIp()%>";
								document.getElementById("orderCost").value = "<%=orderDTO.getOrderTotalAmount()%>";
								document.getElementById("orderCostRound").value = "<%= orderDTO.getOrderTotalAmountRound() %>";
								
								document.getElementById("currencyCode").value = "<%= orderDTO.getCurrencyCode() %>";
								document.getElementById("currencySymbol").value = "<%= orderDTO.getCurrencySymbol() %>";
								document.getElementById("orderId").value = "<%= orderDTO.getId() %>";
								document.getElementById("first_name").value = "<%= orderDTO.getFirstName() %>";
								document.getElementById("last_name").value = "<%= orderDTO.getLastName() %>";
								document.getElementById("company").value = "<%= orderDTO.getCompanyName() %>";
								document.getElementById("phone").value = "<%= orderDTO.getPhoneNo() %>";
								document.getElementById("email").value = "<%= orderDTO.getEmail() %>";
								document.getElementById("notes").value = "<%= orderDTO.getNotes() %>";
								document.getElementById("quantity").value = "<%= orderDTO.getQuantity() %>";
								let filename = "<%= orderDTO.getDocument_name() %>";
								
								if(filename != "null" && filename != null && filename != "" && filename != undefined){
									let files = filename.split(",");
									for(let i = 0; i < files.length; i++){
										$('.upload_gallery').append('<div class="p-2 border rounded"><strong>'+files[i]+'</strong><a class = "ms-2 removeFileBtn text-danger" onclick = "removeFile(this);"><i class="fa fa-times" aria-hidden="true"></i><a></div>');
									}
									
								}
								
							});
							 
						</script>
					<%
					}
					%>
					<%
					    List<String> checkboxValues = new ArrayList<>();
					    if (list != null) {
					        for (CustomerOrderProductDto dto : list) {
					            String productName = dto.getProduct_name().replace("\"", "\\\"");
					            String priceStr = String.format("%.2f", dto.getProduct_price());
					            String checkboxValue = productName + "::" + priceStr;
					            checkboxValues.add(checkboxValue);
					        }
					    }
					%>
					
					<script type="text/javascript">
					   <%--  document.addEventListener("DOMContentLoaded", function () {
					        const checkboxValues = <%= checkboxValues.toString().replace("[", "['").replace("]", "']").replace(", ", "','") %>;
					        checkboxValues.forEach(function (val) {
					            $('input[type="checkbox"][value="' + val + '"]').prop('checked', true);
					        });
					    }); --%>
					</script>

			<form id="checkoutForm" name="checkoutForm" action="#" enctype="multipart/form-data">
				<input type="hidden" id="userIp" name="userIp" /> <input
					type="hidden" id="orderCost" name="orderCost" /> <input
					type="hidden" id="orderCostRound" name="orderCostRound" /> <input
					type="hidden" id="currencyCode" name="currencyCode" /> <input
					type="hidden" id="currencySymbol" name="currencySymbol" /> <input
					type="hidden" id="orderStatus" name="orderStatus" value="0" /> <input
					type="hidden" id="orderId" name="orderId" value="0" /> <input
					type="hidden" id="stripekey" name="stripekey" value="" /> <input
					type="hidden" id="clientSecret" name="clientSecret" value="" /> <input
					type="hidden" id="paymentId" name="paymentId" /> <input
					type="hidden" id="mainOrderId" name="mainOrderId" value="0" />
					<input type="hidden" id="country" name="country" value="" />
					<input type="hidden" id="productId" name="productId" value="<%=serviceDTO.getItem_id() %>" />
					<input type="hidden" id="productPrice" name="productPrice" value="" />
					
				<div class="row">

					<div class="col-md-7 order-1 pe-md-5">

						<div class="row mt-5">
							<h4 class="text-decoration-underline steps-text">Step 1:
								Order Details</h4>
						</div>
						<div class="horizontalLine"></div>
						<div class="row">
							<div class="col mb-4">
								<label class="form-label" class="form-label"> First Name
									<span class="requiredfield">*</span>
								</label> <input type="text" class="required form-control"
									id="first_name" name="first_name"> <span
									class="msgError" id="error_first_name"></span>
							</div>
							<div class="col mb-4">
								<label class="form-label"> Last Name <span
									class="requiredfield">*</span></label> <input type="text"
									class="required form-control" id="last_name" name="last_name">
								<span class="msgError" id="error_last_name"></span>
							</div>
						</div>

						<div class="mb-4">
							<label class="form-label">Company name (optional)</label> <input
								type="text" class="form-control" id="company" name="company">
						</div>

						<div class="mb-4">
							<label class="form-label">Email address <span
								class="requiredfield">*</span></label> <input type="text"
								class="required form-control" id="email" name="email"> <span
								class="msgError" id="error_email"></span>
						</div>
						<div class="mb-4">
							<label class="form-label">Phone <span
								class="requiredfield">*</span></label> <input type="text"
								class="required form-control" id="phone" name="phone"> <span
								class="msgError" id="error_phone"></span>
						</div>

						<div class="horizontalLine"></div>
						<div class="mb-3 mt-3">
							<label class="form-label">Order notes (optional) </label>
							<textarea class="form-control" id="notes" name="notes"
								placeholder="Notes about your order, e.g. special notes for delivery."
								rows="2"> </textarea>
						</div>
						<div class="mb-3 mt-3">
							<fieldset id="drop_zone" class="upload_dropZone text-center mb-3 pb-4">
								<div class = "mt-3 mb-2">
									<label class="form-label fw-bold">Quantity : </label> <input
										type="number" id="quantity" class="input-text qty text-center"
										name="quantity" value="1" min="1" max="5" step="1"
										autocomplete="off">
								</div>
								<legend class="visually-hidden">Image uploader</legend>

								<input id="upload_image_background"
									name="upload_image_background"
									class="position-absolute invisible" type="file" multiple
									accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.ppt,.pptx,.odt" /> <label
									class="btn btn-upload mb-2" for="upload_image_background">
									<svg xmlns="http://www.w3.org/2000/svg" width="32" height="33"
										fill="none">
						        <mask id="a" style="mask-type:alpha"
											maskUnits="userSpaceOnUse" x="0" y="0" width="32" height="33">
						          <path fill="#D9D9D9" d="M0 .203h32v32H0z" />
						        </mask>
						        <g mask="url(#a)">
						          <path
											d="M8.41 26.203a2.327 2.327 0 0 1-1.71-.7 2.327 2.327 0 0 1-.7-1.71v-2.616c0-.284.096-.521.287-.712A.967.967 0 0 1 7 20.177c.284 0 .521.096.713.288a.967.967 0 0 1 .287.712v2.616c0 .102.043.196.128.282.086.085.18.128.282.128h15.18a.392.392 0 0 0 .282-.128.392.392 0 0 0 .128-.282v-2.616c0-.284.096-.521.287-.712a.967.967 0 0 1 .713-.288c.284 0 .521.096.713.288a.967.967 0 0 1 .287.712v2.616c0 .673-.233 1.243-.7 1.71-.467.467-1.037.7-1.71.7H8.41ZM15 10.054l-2.564 2.564a.953.953 0 0 1-.706.294 1.002 1.002 0 0 1-.72-.314 1.044 1.044 0 0 1-.3-.703c-.007-.261.093-.495.3-.702l4.146-4.146A1.103 1.103 0 0 1 16 6.706a1.103 1.103 0 0 1 .844.341l4.146 4.146a.94.94 0 0 1 .293.696c-.002.266-.1.502-.293.709a1.02 1.02 0 0 1-.713.32.944.944 0 0 1-.713-.3L17 10.054v10.2a.967.967 0 0 1-.287.713.967.967 0 0 1-.713.287.967.967 0 0 1-.713-.287.967.967 0 0 1-.287-.713v-10.2Z"
											fill="#212529" />
							        </g>
							      </svg>
								</label>
								
								<h4 class="text-center mb-3 text-decoration-underline steps-text">Step 2: Drag/Drop Files</h4>

								<p class="small my-3">
									Allowed Extensions: <strong>jpg, jpeg, png, pdf, doc,
										docx, ppt, pptx, odt</strong><br> Maximum Upload Filesize: <strong>50MB</strong>
								</p>

								<div id="upload_error" class="text-danger mb-2"
									style="display: none;"></div>
								<div class="upload_gallery d-flex flex-wrap justify-content-center gap-3 mb-0"></div>
								
							</fieldset>
						</div>

					</div>

					<div class="col-md-5 order-2 ps-3 additionalServicesSec"> 
						<div class="border border-2 rounded p-4 mb-4">
							<h5 class="mt-3 mb-5">Additional Services</h5>
							
							
							<div id="addon-container">
								<div class="addon-box">
									<label class="addon-label d-flex justify-content-between">
										<span><input type="checkbox" name="addon_values"
											value="Add Notarization::0.00"
											class="form-check-input addon-checkbox addon-option">
											<span class="addon-title">Add Notarization</span> </span>
									</label>
									<p class="addon-description">Get your document notarized by
										our Notary Public.</p>
								</div>
								<div class="horizontalLine"></div>

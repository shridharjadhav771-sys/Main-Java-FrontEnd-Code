<%
String referrer = request.getHeader("referer") == null ? "" : request.getHeader("referer");
String countryCode = request.getHeader("GEOIP_COUNTRY_CODE") == null ? "" : request.getHeader("GEOIP_COUNTRY_CODE");
String ip = request.getHeader("X-Forwarded-For");
if (ip == null || ip.length() == 0 || "unknown".equalsIgnoreCase(ip)) {
	ip = request.getHeader("Proxy-Client-IP");
}
if (ip == null || ip.length() == 0 || "unknown".equalsIgnoreCase(ip)) {
	ip = request.getHeader("WL-Proxy-Client-IP");
}
if (ip == null || ip.length() == 0 || "unknown".equalsIgnoreCase(ip)) {
	ip = request.getHeader("HTTP_CLIENT_IP");
}
if (ip == null || ip.length() == 0 || "unknown".equalsIgnoreCase(ip)) {
	ip = request.getHeader("HTTP_X_FORWARDED_FOR");
}
if (ip == null || ip.length() == 0 || "unknown".equalsIgnoreCase(ip)) {
	ip = request.getRemoteAddr();
}

boolean isMobile = false;
String isFromMobile = "1";
if (request.getHeader("User-Agent").indexOf("Mobile") != -1) {
	isMobile = true;
	isFromMobile = "2";
}
System.out.println( new Date()  + " "+ referrer + " Country Code: " + countryCode + " Is Mobile: " + isMobile + "  IP : " + ip);

try{ 
	Enumeration<String> params = request.getParameterNames(); 
	while(params.hasMoreElements()){
	 String paramName = params.nextElement();
	 System.out.println(" **** Parameter Name - "+paramName+", Value - "+request.getParameter(paramName));
	}
	
}catch(Exception e){e.printStackTrace();}
%>

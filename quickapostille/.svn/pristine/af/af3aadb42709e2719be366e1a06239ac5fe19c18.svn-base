			$("#headerApostilleBtn").attr("onclick","getApostilleBtn()");
			loadPaymentKeys();
			$.get("https://ipinfo.io", function(response) {
				var userCountry = response.country;
				$("#country").val('FR');
				$("#anotherCountryBox").val('fr');
				document.getElementById("anotherCountryBox").value = 'fr';
				document.getElementById("anotherCountryBox").dispatchEvent(new Event('change'));
				$("#userIp").val(response.ip);
				setCurrency('FR');
				handlePageShowLogic();
			}, "jsonp");

		});
		function handlePageShowLogic() {
		    if (performance.navigation.type === 2) {
		        $.ajax({
		            url: 'finalizecustomerorder',
		            method: 'GET',
		            dataType: 'json',
		            success: function (resp) {
		                if (resp) {
		                    let data = resp.orderDTO;
		                    let addonlist = resp.addonList;

		                    $("#userIp").val(data.userIp || "");
		                    $("#orderCost").val(data.orderTotalAmount || "");
		                    $("#orderCostRound").val(data.orderTotalAmountRound || "");
		                    $("#currencyCode").val(data.currencyCode || "");
		                    $("#currencySymbol").val(data.currencySymbol || "");
		                    $("#orderId").val(data.id || "");
		                    $("#first_name").val(data.firstName || "");
		                    $("#last_name").val(data.lastName || "");
		                    $("#company").val(data.companyName || "");
		                    $("#phone").val(data.phoneNo || "");
		                    $("#email").val(data.email || "");
		                    $("#notes").val(data.notes || "");
		                    $("#quantity").val(data.quantity || "");
		                    updateProductCost();
		                    let filename = data.document_name;
		                    $('.upload_gallery').empty();
		                    if(filename != "null" && filename != null && filename != "" && filename != undefined){
								let files = filename.split(",");
								for(let i = 0; i < files.length; i++){
									$('.upload_gallery').append('<div class="p-2 border rounded"><strong>'+files[i]+'</strong><a class = "ms-2 removeFileBtn text-danger" onclick = "removeFile(this);"><i class="fa fa-times" aria-hidden="true"></i><a></div>');
								}
								
							}
		    	            /* updateAddonPrices(); */
		                    $('[name="addon_values"]').prop("checked",false);

		                    if (addonlist) {
		                        addonlist.forEach(function (val) {
		                            $('input[type="checkbox"][value="' + val.product_name + "::" + (val.product_price).toFixed(2) + '"]').prop('checked', true);
		                        });
		                    }
		                } else {
		                    console.warn("No order data found.");
		                }
		            },
		            error: function (xhr, status, error) {
		                console.error("Error fetching data:", error);
		            }
		        });
		    }else{
		    	const checkboxValues = <%= checkboxValues.toString().replace("[", "['").replace("]", "']").replace(", ", "','") %>;
		        checkboxValues.forEach(function (val) {
		            $('input[type="checkbox"][value="' + val + '"]').prop('checked', true);
		        });
		       /*  updateTotal(); */
		    }
		}
	</script>

	<script type="text/javascript">
	let baseProductPrice = 0.00; 
	let product = baseProductPrice;
	let total = 0;

	document.addEventListener("DOMContentLoaded", function () {
	    updateProductCost();

	    $('#quantity').on('input', function () {
	        let value = parseInt(this.value);

	        if (!isNaN(value) && value >= 1 && value <= 5) {
	            updateProductCost();
	        } else {
	            this.value = 1;
	            updateProductCost();
	        }
	    });

	});
	function updateAddonPrices() {
	    let quantity = parseInt($('#quantity').val());
	    if (isNaN(quantity) || quantity < 1) quantity = 1;

	    document.querySelectorAll('.addon-option').forEach(function (checkbox, index) {
	        let originalValue = checkbox.getAttribute('data-original-value');
	        if (!originalValue) {
	            originalValue = checkbox.value;
	            checkbox.setAttribute('data-original-value', originalValue);
	        }
	        let [text, value] = originalValue.split("::");
	        let newPrice = parseFloat(value) * quantity;
	        checkbox.value = text + "::" + newPrice.toFixed(2);
	        $(checkbox).next('label').text(text + " (" + selectedcurrency + newPrice.toFixed(2) + ")");
	    });
	}
	function updateProductCost() {
	    let quantity = parseInt($('#quantity').val());
	    if (isNaN(quantity) || quantity < 1) quantity = 1;
	    product = baseProductPrice * quantity;
	}
	function updateTotal() {
	    total = 0;
	    document.querySelectorAll('.addon-option:checked').forEach(function (checkbox) {
	        total += parseFloat(checkbox.value.split("::")[1]) * $('#quantity').val();
	    });

	    let finalCost = total + product;
	    $("#orderCost").val(finalCost.toFixed(2));
	    $("#orderCostRound").val((finalCost * 100).toFixed(0));
	}
		function getApostilleBtn(){
			window.scrollTo(0, findPosition(document.getElementById("checkoutForm")));
		 }
		function findPosition(obj) {
            let currenttop = 0;
            if (obj.offsetParent) {
                do {
                    currenttop += obj.offsetTop - 40;
                } while ((obj = obj.offsetParent));
                return [currenttop];
            }
        }
		function setCurrency(country) {
			const prices = {
					AE: {
			        	product: '<%=String.format("%.2f",serviceDTO.getItem_uae_price())%>',
			            addonTexts: [
			            <% 
			                if (addonsList != null) {
			                    for (int i = 0; i < addonsList.size(); i++) {
			                        AddonsDTO addon = addonsList.get(i);
			                        String comma = (i < addonsList.size() - 1) ? "," : "";
			            %>
			                '<%= addon.getAddon_name() %>::<%= String.format("%.2f", addon.getUae_price())%>'<%= comma %>
			            <% 
			                    }
			                }
			            %>
			            ]
			        },
			        GBP: {
			            product: '<%=String.format("%.2f",serviceDTO.getItem_gbp_price())%>',
			            addonTexts: [
			            <% 
			                if (addonsList != null) {
			                    for (int i = 0; i < addonsList.size(); i++) {
			                        AddonsDTO addon = addonsList.get(i);
			                        String comma = (i < addonsList.size() - 1) ? "," : "";
			            %>
			                '<%= addon.getAddon_name() %>::<%= String.format("%.2f", addon.getGbp_price())%>'<%= comma %>
			            <% 
			                    }
			                }
			            %>
			            ]
			        },
			        EUR: {
			        	product: '<%=String.format("%.2f",serviceDTO.getItem_euro_price())%>',
			            addonTexts: [
			            <% 
			                if (addonsList != null) {
			                    for (int i = 0; i < addonsList.size(); i++) {
			                        AddonsDTO addon = addonsList.get(i);
			                        String comma = (i < addonsList.size() - 1) ? "," : "";
			            %>
			                '<%= addon.getAddon_name() %>::<%= String.format("%.2f", addon.getEuro_price())%>'<%= comma %>
			            <% 
			                    }
			                }
			            %>
			            ]
			        },
			        DEFAULT: {
			        	product: '<%=String.format("%.2f",serviceDTO.getItem_us_price())%>',
			            addonTexts: [
			            <% 
			                if (addonsList != null) {
			                    for (int i = 0; i < addonsList.size(); i++) {
			                        AddonsDTO addon = addonsList.get(i);
			                        String comma = (i < addonsList.size() - 1) ? "," : "";
			            %>
			                '<%= addon.getAddon_name() %>::<%= String.format("%.2f", addon.getUs_price())%>'<%= comma %>
			            <% 
			                    }
			                }
			            %>
			            ]
			        }
			    };

			let priceSet;
			let currencySymbol = "\u0024";
			let currencyCode = "USD";

			if (country === 'AE') {
				priceSet = prices.AE;
				currencySymbol = "AED ";
				currencyCode = "AED";
			} else if (country === 'GB') {
				priceSet = prices.GBP;
				currencySymbol = "\u00A3";
				currencyCode = "GBP";
			} else if (country !== '' && country !== 'US' && country !== 'IN') {
				priceSet = prices.EUR;
				currencySymbol = "\u20AC";
				currencyCode = "EUR";
			} else {
				priceSet = prices.DEFAULT;
			}

	    baseProductPrice = parseFloat(priceSet.product);
	    updateProductCost();

	    $('[name="addon_values"]').each(function (index) {
	        if (priceSet.addonTexts[index]) {
	            $(this).val(priceSet.addonTexts[index]);
	            $(this).next('label').text(priceSet.addonTexts[index].split('::')[0]);
	            this.setAttribute("data-original-value", priceSet.addonTexts[index]);
	            this.value = priceSet.addonTexts[index];
	        }
	    });	
	    $("#productPrice").val(baseProductPrice);
	    selectedcurrency = currencySymbol;
	    $("#currencyCode").val(currencyCode);
	    $(".currencySymbol").text(currencySymbol);
	    $("#currencySymbol").val(currencySymbol.trim());
	}
		function changeCountry(country){
			country = country.toUpperCase();
			if (country === 'GB') {
				window.location.href = "service_uk.jsp";
			}else if(country === 'AE'){
				window.location.href = "service_uae.jsp";
			}else if(country === 'US'){
				window.location.href = "service_us.jsp";
			} else if(country === 'IE'){
				window.location.href = "service_ireland.jsp";			
			}else if(country === 'ES'){
				window.location.href = "service_spain.jsp";			
			}else if(country === 'IT'){
				window.location.href = "service_it.jsp";			
			}else if(country !== 'FR')  {
				window.location.href = "service.jsp";
			}
		}
		function loadPaymentKeys() {
			$.ajax({
				url : 'paykeys',
				type : 'GET',
				success : function(data) {

				},
				failure : function(data) {
					console.log(data);
				}
			});
		}

		$(document).ready(
				function() {
					$(".faq-question").on(
							"click",
							function() {
								var $this = $(this);
								var target = $this.data("bs-target");
								if ($(target).hasClass("show")) {
									$(target).collapse('hide');
									$this.removeClass("active");
									$this.find("i").removeClass("fa-angle-up")
											.addClass("fa-angle-down");
								} else {
									$(".faq-question").removeClass("active")
											.find("i").removeClass(
													"fa-angle-up").addClass(
													"fa-angle-down");
									$(".collapse.show").collapse('hide');
									$this.addClass("active");
									$(target).collapse('show');
									$this.find("i")
											.removeClass("fa-angle-down")
											.addClass("fa-angle-up");
								}
							});
					$('.imageContainer').slick({
						slidesToShow : 4,
						slidesToScroll : 1,
						infinite : true,
						arrows : false,
						dots : true,
						autoplay : true,
						autoplaySpeed : 2000,
						centerMode : false,
						responsive : [ {
							breakpoint : 768,
							settings : {
								slidesToShow : 2
							}
						}, {
							breakpoint : 480,
							settings : {
								slidesToShow : 1
							}
						} ]
					});
					$('.testimonial-carousel').slick({
						slidesToShow : 1,
						slidesToScroll : 1,
						infinite : true,
						arrows : false,
						dots : true,
						autoplay : true,
						autoplaySpeed : 2000,
						centerMode : false,
						responsive : [ {
							breakpoint : 768,
							settings : {
								slidesToShow : 2
							}
						}, {
							breakpoint : 480,
							settings : {
								slidesToShow : 1
							}
						} ]
					});
					initializeMobileSlider();
				});
		var swiper = new Swiper(".mySwiper", {
			slidesPerView : 3,
			slidesPerGroup : 3,
			spaceBetween : 10,
			loop : true,
			loopAdditionalSlides : 3, // important for loop + group combo
			autoplay : {
				delay : 2000,
				disableOnInteraction : false,
			},
			speed : 600,
			breakpoints : {
				1024 : {
					slidesPerView : 3,
					slidesPerGroup : 3,
				},
				768 : {
					slidesPerView : 2,
					slidesPerGroup : 2,
				},
				480 : {
					slidesPerView : 1,
					slidesPerGroup : 1,
				}
			}
		});

		$('.collapse').on(
				'shown.bs.collapse',
				function() {
					var question = $(this).prev('.faq-question');
					question.find("i").removeClass("fa-angle-down").addClass(
							"fa-angle-up");
				});

		$('.collapse').on(
				'hidden.bs.collapse',
				function() {
					var question = $(this).prev('.faq-question');
					question.find("i").removeClass("fa-angle-up").addClass(
							"fa-angle-down");
				});
		$(window).on('resize', function() {
			initializeMobileSlider();
		});
		function initializeMobileSlider() {
			if ($(window).width() < 768) {
				if (!$('.testimonial-carousel').hasClass('slick-initialized')) {
					$('.testimonial-carousel').slick({
						slidesToShow : 1,
						slidesToScroll : 1,
						infinite : true,
						arrows : false,
						dots : true,
						autoplay : true,
						autoplaySpeed : 2000,
						centerMode : false
					});
				}
			} else {
				if ($('.testimonial-carousel').hasClass('slick-initialized')) {
					$('.testimonial-carousel').slick('unslick');
				}
			}
		}
		var form = document.checkoutForm; 
		form.addEventListener('submit', function(e) {
		    e.preventDefault();

		    let isValid = true;
		    document.querySelectorAll(".msgError").forEach(el => el.innerText = "");
		    document.querySelectorAll(".required").forEach(field => {
		      field.classList.remove("is-invalid");
		    });

		    document.querySelectorAll(".required").forEach(field => {
		      const isVisible = field.offsetParent !== null;
		      const errorSpanId = "error_" + field.id;
		      const errorSpan = document.getElementById(errorSpanId);
		      let value = "";

		      if (isVisible) {
		        const tag = field.tagName.toLowerCase();
		        if (tag === "input" || tag === "textarea" || tag === "select") {
		          if (field.id === 'agreeTerms' && !field.checked) {
		            errorSpan.innerText = "This field is required.";
		          } else {
		            value = field.value.trim();
		          }
		        }

		        if (!value) {
		          if (errorSpan) errorSpan.innerText = "This field is required.";
		          field.classList.add("is-invalid");
		          isValid = false;
		        }
		      }
		    });

		  /*  if (uploadedFiles.length === 0) {
		      showError('Please upload at least one file.');
		      isValid = false;
		    } */

		    if (isValid) {
		      updateTotal();
		      let formData = new FormData(form);
		      formData.append("removedFiles", JSON.stringify(removedFiles));
		      uploadedFiles.forEach(file => {
		        formData.append("upload_images", file);
		      });
				$.ajax({
			        url: 'finalizecustomerorder',
			        type: 'POST',
			        data: formData,
			        contentType: false,
			        processData: false,
			        success: function(response) { 
			            var res = eval(response);
			            console.log(res);
			            window.location.href = "checkout.jsp";
			        },
			        error: function(error) {
			        	 console.log(error);
			        } 
				});
				
			}
		});

		function showError(msg) {
		    const errorBox = document.querySelector('#upload_error');
		    if (errorBox) {
		        errorBox.innerText = msg;
		        errorBox.style.display = 'block';
		    }
		}
		  const dropZone = document.getElementById('drop_zone');
		  const fileInput = document.getElementById('upload_image_background');
		  const uploadError = document.getElementById('upload_error');
		  const gallery = document.querySelector('.upload_gallery');
		  const MAX_FILES = 10;
		  let uploadedFiles = [];
		  function updateGallery(newfile) {
			    /* gallery.innerHTML = '';  */
			    newfile.forEach(file => { 
			        const preview = document.createElement('div');
			        preview.classList.add('p-2', 'border', 'rounded');
			        preview.innerHTML = '<strong>' + file.name + '</strong> (' + (file.size / 1024).toFixed(1) + ' KB)<a class = "ms-2 removeFileBtn text-danger" onclick = "removeFile(this);"><i class="fa fa-times" aria-hidden="true"></i><a>';
			        gallery.appendChild(preview);
			      });
			  }
		  ['dragenter', 'dragover'].forEach(eventName => {
			    dropZone.addEventListener(eventName, () => {
			      dropZone.classList.add('highlight');
			    });
			  });

			  ['dragleave', 'drop'].forEach(eventName => {
			    dropZone.addEventListener(eventName, () => {
			      dropZone.classList.remove('highlight');
			    });
			  });

			  dropZone.addEventListener('drop', e => {
			    const files = e.dataTransfer.files;
			    handleFiles(files);
			  });

			  fileInput.addEventListener('change', () => {
			    handleFiles(fileInput.files);
			  });

		  function handleFiles(files) {
			    uploadError.style.display = 'none';
			    const allowedExts = ['jpg', 'jpeg', 'png', 'pdf', 'doc', 'docx', 'ppt', 'pptx', 'odt'];
			    const maxSize = 50 * 1024 * 1024;

			    const newFiles = Array.from(files).filter(file => {
			      const ext = file.name.split('.').pop().toLowerCase();

			      if (!allowedExts.includes(ext)) {
			        showError('File ' + file.name + ' has unsupported format.');
			        return false;
			      }

			      if (file.size > maxSize) {
			        showError('File ' + file.name + ' exceeds 50MB limit.');
			        return false;
			      }

			      return true;
			    });

			    if (($('.upload_gallery').find('div').length + newFiles.length) > MAX_FILES) {
			      showError('You can upload a maximum of 10 files.');
			      return;
			    }

			    uploadedFiles.push(...newFiles);
			    updateGallery(newFiles);
			  }

			  ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
			    dropZone.addEventListener(eventName, e => {
			      e.preventDefault();
			      e.stopPropagation();
			    });
			  });
		   let removedFiles = [];

		  function removeFile(el) {
		      const filename = $(el).prev().text().trim(); 
		      removedFiles.push(filename); 
		      $(el).parent().remove();
		  }
		  
	</script>

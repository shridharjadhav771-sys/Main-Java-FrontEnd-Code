															<span class="addon-title"><%=addonList.get(i).getProduct_name() %></span> </span>
															<span><span class="currencySymbol"></span><span class="addon-price"><%= String.format("%.2f", addonList.get(i).getProduct_price()) %></span></span>
													</label>
													<span></span>

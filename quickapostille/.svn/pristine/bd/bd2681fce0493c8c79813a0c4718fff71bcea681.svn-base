	<section class="mt-5">

		<div class="container">

			<div class="row">
				<div class="col-md-1 com-sm-0"></div>
				<div class="col-md-10 com-sm-12">
					<div class="justify-content-between">
						<div class="row">
							<p class="justify-content-between">
								We are ready to finalize your order. Please bear in mind that
								your order is pending until we receive your ID check and
								ascertain your uploaded documents. Today we will be charging you
								card a total of <span id="itempriice"></span> for apostille
								service, plus any fees for notarization, certified copies,
								express services, or translation. Once your order is placed, we
								will verify your ID with a third party service and when
								complete, we will begin processing your order. Please bear in
								mind we will strive to complete the process in 1 day or less
								based on the document characteristics. Feel free to contact us
								at any time to check your order status and or amend any items.
							</p>
						</div>
						<div class="row">
							<div class="col-md-12 text-center">
								<h1 class="">
									<img style="width: 150px"
										src="images/common_law_assosiation.jpg"
										alt="common law assosiation" />
								</h1>
							</div>
							<div class="col-md-12 text-center">
								<h4 class="mb-5 mt-4 text-decoration-underline steps-text">Step
									3: Finalize Order</h4>
							</div>
						</div>
					</div>
				</div>
				<div class="col-md-1 com-sm-0"></div>

			</div>
			<div class="horizontalLine mb-0"></div>
			<form id="checkoutForm" name="checkoutForm" action="#">
				<input type="hidden" id="first_name" name="first_name"
					value="${orderDTO.firstName}" /> <input type="hidden"
					id="last_name" name="last_name" value="${orderDTO.lastName}" /> <input
					type="hidden" id="email" name="email" value="${orderDTO.email}" />
				<input type="hidden" id="phone" name="phone"
					value="${orderDTO.phoneNo}" /> <input type="hidden" id="orderCost"
					name="orderCost" value="${orderDTO.orderTotalAmount}" /> <input
					type="hidden" id="orderCostRound" name="orderCostRound"
					value="${orderDTO.orderTotalAmountRound}" /> <input type="hidden"
					id="currencyCode" name="currencyCode"
					value="${orderDTO.currencyCode}" /> <input type="hidden"
					id="currencySymbol" name="currencySymbol"
					value="${orderDTO.currencySymbol}" /> <input type="hidden"
					id="orderStatus" name="orderStatus" value="0" /> <input
					type="hidden" id="orderId" name="orderId" value="${orderDTO.id}" />
				<input type="hidden" id="stripekey" name="stripekey" value="" /> <input
					type="hidden" id="clientSecret" name="clientSecret" value="" /> <input
					type="hidden" id="paymentId" name="paymentId" /> <input
					type="hidden" id="mainOrderId" name="mainOrderId" value="0" /> <input
					type="hidden" id="isfile" name="isfile" value="0" /> <input
					type="hidden" id="notes" name="notes" value="${orderDTO.notes}" />
					<input
					type="hidden" id="isDynamicShipping" name="isDynamicShipping" value="1" />
				
				<div class="row">
					<div class="mb-0 text-end ">
						<img class="w-25 mb-1" src="images/secure_checkout.png"
							alt="secure checkout">
					</div>

					<div class="col-md-6 col-xs-12  order-2 ps-3">
						<div class="border border-2 rounded p-4 mb-4">
							<div class="mb-4">
								<div class="p-2" id="card-fields">
									<fieldset>
										<legend class="fieldset-legend">
											<strong>Billing Address:</strong>
										</legend>

										<div class="row p-2" style="padding: 0px;">
											<div class="col-sm-12 col-xs-12 mt-2">
												<strong class="d-block mb-1">Street Address <span
													class="requiredfield">*</span></strong> <input type="text"
													class="required form-control" id="street" name="street"
													placeholder="Billing Address"> <span
													class="msgError" id="error_street"></span>

											</div>
										</div>
										<div class="row p-2" style="padding: 0px;">
											<div class="col-sm-12 col-md-6 mt-2">
												<strong class="d-block mb-1">Billing City <span
													class="requiredfield">*</span></strong> <input type="text"
													class="required form-control" id="city" name="city"
													placeholder="Billing City"> <span class="msgError"
													id="error_city"></span>
											</div>

											<div class="col-sm-12 col-md-6 mt-2">

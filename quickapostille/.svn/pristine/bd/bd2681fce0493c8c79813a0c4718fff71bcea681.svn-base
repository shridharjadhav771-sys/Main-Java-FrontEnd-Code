	<script>
		var selectedcurrency = "$";
		var selectedcountry = "${orderDTO.country}";
		$(function() {
			loadPaymentKeys();
			$.get("https://ipinfo.io", function(response) {
				var userCountry = response.country;
				if(selectedcountry !=  "" && selectedcountry != null){
					userCountry = selectedcountry;
				}
				
				$("#country").val(userCountry);
				$("#userIp").val(response.ip);
				setupItemPrice(userCountry);
			}, "jsonp");			
			$('[name="shipping_method"]').change(function() {
				updateTotal();
			});
		});
	</script>
	<script type="text/javascript">
		function loadPaymentKeys() {
			$.ajax({
				url : 'paykeys',
				type : 'GET',
				success : function(data) {

				},
				failure : function(data) {
					console.log(data);
				}
			});
		}
		function setupItemPrice(country) {
			var currencySymbol = "\u0024";
			var currencyCode = "USD";
			var itemPrice = "180.00";

			if (country === 'GB') {
				currencySymbol = "\u00A3";
				currencyCode = "GBP";
				itemPrice = "180.00";
			} else if (country === 'AE') {
				currencySymbol = "AED ";
				currencyCode = "AED";
				itemPrice = "800.00";
			} else if (country !== '' && country !== 'US' && country !== 'IN') {
				currencySymbol = "\u20AC";
				currencyCode = "EUR";
				itemPrice = "180.00";
			}

			$("#itempriice").html(currencySymbol + itemPrice);
			$(".currencySymbol").html(currencySymbol);
			$("#currencySymbol").val(currencySymbol);
			$("#currencyCode").val(currencyCode);
			$("#productTotal").html(itemPrice);
			
			updateTotal();
		}

		function updateTotal() {
			let product = parseFloat(document.getElementById("productTotal").innerText.replace(/[^\d.]/g, ''));
			let shippingcharges = parseFloat($('[name="shipping_method"]:checked').next().find(".charges").text().replace(/[^\d.]/g,''));
			total = 0;
			$('.addon-box').each(function () {
		        let price = $(this).find('.addon-price').text().trim();
		        total += parseFloat(price);
		    });
			let charges = parseFloat($('[name="shipping_method"]:checked').next().find(".charges").text().replace(/[^\d.]/g, ''));
			document.getElementById("totalPrice").innerText = (total + product + charges).toFixed(2);
			$("#orderCost").val((total + product + shippingcharges).toFixed(2));
			let orderCostRound = ((total + product + shippingcharges).toFixed(2)) * 100;
			$("#orderCostRound").val(orderCostRound);
		}
		function updateAddons(orderid,elm) {
			$(elm).closest('.addon-box').remove();
		    let selectedAddons = [];
		    if($('.addon-box').length == 0){
		    	
		    	if($('#services').next().hasClass("horizontalLine"))$('#services').next().remove();
		    	$('#services').remove();
		    }
		    $('.addon-box').each(function () {
		        let title = $(this).find('.addon-title').text().trim();
		        let price = $(this).find('.addon-price').text().trim();
		        selectedAddons.push(title+'::'+price);
		    });
		    updateTotal();
		    $.ajax({
		        url: 'updateorderdetailsservice',
		        type: 'POST',
		        data: {
		            action: 'updateaddons',
		            addons: JSON.stringify(selectedAddons),
		            order_id: orderid,
		            total_amount : $("#orderCost").val(),
		        },
		        success: function (response) {
		            console.log('Addons updated:', response);
		        },
		        error: function (xhr, status, error) {
		            console.error('Error updating addons:', error);
		        }
		    });
		}
		
	</script>
	<script async data-id="101481203" src="//static.getclicky.com/js"></script>

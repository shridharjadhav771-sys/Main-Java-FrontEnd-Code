								<option value="TO">Tonga</option>
								<option value="TT">Trinidad and Tobago</option>
								<option value="TN">Tunisia</option>
								<option value="TR">Turkey</option>
								<option value="TM">Turkmenistan</option>
								<option value="TC">Turks and Caicos Islands</option>
								<option value="TV">Tuvalu</option>
								<option value="UG">Uganda</option>
								<option value="UA">Ukraine</option>
								<option value="AE">United Arab Emirates</option>
								<option value="GB">United Kingdom (UK)</option>
								<option value="US">United States (US)</option>
								<option value="UM">United States (US) Minor Outlying
									Islands</option>
								<option value="UY">Uruguay</option>
								<option value="UZ">Uzbekistan</option>
								<option value="VU">Vanuatu</option>
								<option value="VA">Vatican</option>
								<option value="VE">Venezuela</option>
								<option value="VN">Vietnam</option>
								<option value="VG">Virgin Islands (British)</option>
								<option value="VI">Virgin Islands (US)</option>
								<option value="WF">Wallis and Futuna</option>
								<option value="EH">Western Sahara</option>
								<option value="YE">Yemen</option>
								<option value="ZM">Zambia</option>
								<option value="ZW">Zimbabwe</option>
							</select> <span class="msgError" id="error_country"></span>
						</div>

						<div class="mb-4">
							<label class="form-label">Street address <span
								class="requiredfield">*</span></label> <input type="text"
								class="required form-control"
								placeholder="House number and street name" id="street_address"
								name="street"> <span class="msgError"
								id="error_street_address"></span>
						</div>

						<div class="mb-4">
							<label class="form-label">Apartment, suite, unit, etc.
								(optional)</label> <input type="text" class="form-control"
								placeholder="Apartment, suite, unit, etc. (optional)"
								id="apartment">
						</div>
						<div class="mb-4">
							<label class="form-label">Town / City <span
								class="requiredfield">*</span></label> <input type="text"
								class="required form-control" id="city" name="city"> <span
								class="msgError" id="error_city"></span>
						</div>
						<div class="mb-4">
							<label class="form-label">State / County <span
								class="requiredfield">*</span></label> <input type="text"
								class="required form-control" id="state" name="state"> <span
								class="msgError" id="error_state"></span>
						</div>
						<div class="mb-4">
							<label class="form-label">Postcode / ZIP <span
								class="requiredfield">*</span></label> <input type="text"
								class="required form-control" id="zip_code" name="zip">
							<span class="msgError" id="error_zip_code"></span>
						</div>
						<div class="mb-4">
							<label class="form-label">Phone <span
								class="requiredfield">*</span></label> <input type="text"
								class="required form-control" id="phone" name="phone"> <span
								class="msgError" id="error_phone"></span>
						</div>
						<div class="mb-4">
							<label class="form-label">Email address <span
								class="requiredfield">*</span></label> <input type="text"
								class="required form-control" id="email" name="email"> <span
								class="msgError" id="error_email"></span>
						</div>
						<div class="horizontalLine"></div>
						<div class="mb-3 mt-3">
							<label class="form-label">Order notes (optional) </label>
							<textarea class="form-control" id="notes"
								placeholder="Notes about your order, e.g. special notes for delivery."
								rows="2"> </textarea>
						</div>

					</div>

					<div class="col-md-5 order-2 mt-5 ps-3">

						<div class="border border-2 rounded p-4 mb-4">
							<h5 class="mt-3">Your Order</h5>
							<div class="d-flex justify-content-between mb-2 mt-4">
								<label class="form-label"><strong>Product</strong></label> <label
									class="form-label"><strong>Subtotal</strong></label>
							</div>
							<div class="d-flex justify-content-between mb-2">
								<span>Apostille</span> <span><span
									class="currencySymbol"></span><span id="productTotal">180.00</span></span>
							</div>
							<div class="horizontalLine"></div>
							<div id="addon-container">
								<div class="addon-box">
									<label class="addon-label d-flex justify-content-between">
										<span><input type="checkbox" name="addon_values"
											value="Add Notarization::80.00"
											class="form-check-input addon-checkbox addon-option">
											<span class="addon-title">Add Notarization</span> </span><span>
											<span class="currencySymbol"></span><span class="addon-price">80.00</span></span>
									</label>
									<p class="addon-description">Get your document notarized by
										our Notary Public.</p>
								</div>
								<div class="horizontalLine"></div>
								<div class="addon-box">
									<label class="addon-label d-flex justify-content-between"><span>
											<input type="checkbox" name="addon_values"
											value="Add Translation::70.00"
											class="form-check-input addon-checkbox addon-option">
											<span class="addon-title">Add Translation</span>
									</span> <span><span class="currencySymbol"></span><span class="addon-price">70.00</span></span>
									</label>
									<p class="addon-description">Make your document bilingual.</p>
								</div>
								<div class="horizontalLine"></div>
								<div class="addon-box">
									<label class="addon-label d-flex justify-content-between">
										<span><input type="checkbox" name="addon_values"
											value="Add Certified Copy of Passport/ID::60.00"
											class="form-check-input addon-checkbox addon-option">
											<span class="addon-title">Add Certified Copy of
												Passport/ID</span></span> <span><span
											class="currencySymbol"></span><span class="addon-price">60.00</span></span>
									</label>
									<p class="addon-description">Add a notarized copy of your
										Passport or ID card to your Apostilled document.</p>
								</div>
								<div class="horizontalLine"></div>
								<div class="addon-box">
									<label class="addon-label d-flex justify-content-between">
										<span><input type="checkbox" name="addon_values"
											value="Express Service::60.00"
											class="form-check-input addon-checkbox addon-option">
											<span class="addon-title">Express Service</span></span> <span>
											<span class="currencySymbol"></span><span class="addon-price">60.00</span></span>
									</label>
									<p class="addon-description">With Express Service, your
										order will be fulfilled with the highest priority.</p>
								</div>
							</div>

							<div class="horizontalLine"></div>
							<div class="d-flex justify-content-between mb-2">
								<span class="fw-bold">Subtotal</span> <span><span
									class="currencySymbol fw-bold"></span><span id="subtotal"
									class="fw-bold">180.00</span></span>
							</div>
							<div class="horizontalLine"></div>

							<div class="mb-3 mt-5">
								<div>
								<strong class="d-block mb-1">Shipping Options <a class="p-2 align-middle" data-bs-toggle="collapse" href="#shippingOptions" role="button" aria-expanded="false" aria-controls="shippingOptions"> <i class="bi bi-arrow-down-circle-fill"></i> </a> </strong> 
								</div>
								<div class="horizontalLine"></div>
								<div class="collapse" id="shippingOptions">
								<div class="form-check mt-4">
									<input class="form-check-input" type="radio"
										name="shipping_method" id="onlineCopy"
										value="Online Copy (Email)::0.00" checked> <label
										class="form-check-label d-flex justify-content-between"
										for="onlineCopy"> Online Copy (Email): <span
										class="charges"><span class="currencySymbol"></span>0.00</span>
									</label>
								</div>
								<div class="horizontalLine"></div>
								<div class="form-check mt-2">
									<input class="form-check-input" type="radio"
										value="Local Registered Mail (With Tracking-nr)::49.00"
										name="shipping_method" id="localMail"> <label
										class="form-check-label d-flex justify-content-between"
										for="localMail"> Local Registered Mail (With
										Tracking-nr): <span class="charges"><span
											class="currencySymbol"></span>49.00</span>
									</label>
								</div>
								<div class="horizontalLine"></div>
								<div class="form-check mt-2">
									<input class="form-check-input" type="radio"
										value="DHL Express (With Tracking-nr)::89.00"
										name="shipping_method" id="dhlExpress"> <label
										class="form-check-label d-flex justify-content-between"
										for="dhlExpress"> DHL Express (With Tracking-nr): <span
										class="charges"><span class="currencySymbol"></span>89.00</span>
									</label>
								</div>
								<div class="horizontalLine"></div>
								</div>
							</div>


							<div class="d-flex justify-content-between fs-5 mt-5">
								<strong>Total</strong> <strong><span><span
										class="currencySymbol"></span><span id="totalPrice">00</span></span></strong>
							</div>
							<div class="horizontalLine"></div>
							<div id="paymentErrorDiv" class="alert alert-danger" role="alert"
								style="display: none">
								<span id="errormsg"></span>
							</div>
							<!-- Payment Section -->
							<div class="mb-4">
								<div class="p-2 bg-light" id="card-fields">
									<fieldset>
										<legend class="fieldset-legend">Credit / Debit Card: <img id = "credit_cardimg" alt="credit cards" src="images/cardlogo.png"></legend>
										<div class="row p-2" style="padding: 0px;">
											<div class="col-sm-12 col-xs-12">
												<strong class="d-block mb-1">Card number</strong>
												<div id="stripe-card-number" class="form-control"
													style="padding: 10px;"></div>

											</div>
										</div>
										<div class="row p-2" style="padding: 0px;">
											<div class="col-sm-12 col-md-6">
												<strong class="d-block mb-1">Expiration date</strong>
												<div id="stripe-card-expiry" class="form-control"
													style="padding: 10px;"></div>
											</div>

											<div class="col-sm-12 col-md-6">
												<strong class="d-block mb-1">Security code</strong>
												<div id="stripe-card-cvc" class="form-control"
													style="padding: 10px;"></div>

											</div>
										</div>
									</fieldset>
								</div>
								<!-- Terms and Place Order -->
								 
								<div class="form-check mb-3 mt-3">
									<input class="required form-check-input" type="checkbox"
										id="agreeTerms"> <label class="form-label"
										for="agreeTerms"> I have read and agree to the <a
										href="https://www.quickapostille.online/terms-and-conditions/"
										target="_blank"> Terms & Conditions</a> <span
										class="requiredfield">*</span>
									</label> <span class="msgError" id="error_agreeTerms"></span>
								</div>

								<button class="btn btn-lg w-100 mt-3" type="submit"
									id="submitbtn">PLACE ORDER</button>
							</div>
						</div>

					</div>
				</div>
			</form>
		</div>

	</section>


		src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
	<script>
		var selectedcurrency = "$";
		$(function() {
			loadPaymentKeys();
			$.get("https://ipinfo.io", function(response) {
				var userCountry = response.country;
				//getCurrencyByCountry(userCountry, defaultCurrency);
				//console.log(response.city, response.country);
				$("#country").val(response.country);
				$("#userIp").val(response.ip);
				setCurrency(response.country);
			}, "jsonp");

		});
	</script>
	<script type="text/javascript">
	let product = "180.00";
		document.addEventListener("DOMContentLoaded",function() {
							let total = 0;
							let subtotal = parseFloat(document.getElementById("subtotal").innerText.replace(/[^\d.]/g, ''));
							let product = parseFloat(document.getElementById("productTotal").innerText.replace(/[^\d.]/g, ''));
							let shippingcharges = parseFloat($('[name="shipping_method"]:checked').next().find(".charges").text().replace(/[^\d.]/g,''));
							document.getElementById("totalPrice").innerText = (total+ product + shippingcharges).toFixed(2);
							$("#orderCost").val((total + product + shippingcharges).toFixed(2));
							let orderCostRound = ((total + product + shippingcharges).toFixed(2)) * 100;
							$("#orderCostRound").val(orderCostRound);
							

							document.querySelectorAll(".addon-option").forEach(function(input) {
									input.addEventListener("change",
												updateTotal);
									});
							$('[name="shipping_method"]').change(function() {
								updateTotal();
							});
						});
		function updateTotal() {
			total = 0;
			let product = parseFloat(document.getElementById("productTotal").innerText.replace(/[^\d.]/g, ''));
			let shippingcharges = parseFloat($('[name="shipping_method"]:checked').next().find(".charges").text().replace(/[^\d.]/g,''));
			let checkboxes = document.querySelectorAll('.addon-option:checked');
			checkboxes.forEach(function(checkbox) { 			
				total += parseFloat(checkbox.value.split("::")[1]);
			});
			let shipping = $('[name="shipping_method"]:checked').next().find(".charges").text().replace(/[^\d.]/g, '')
			document.getElementById("subtotal").innerText = (total + product).toFixed(2);
			let charges = parseFloat($('[name="shipping_method"]:checked').next().find(".charges").text().replace(/[^\d.]/g, ''));
			document.getElementById("totalPrice").innerText = (total + product + charges).toFixed(2);
			$("#orderCost").val( (total + product + shippingcharges).toFixed(2));
			let orderCostRound = ((total + product + shippingcharges).toFixed(2)) * 100;
			$("#orderCostRound").val(orderCostRound);
		}

		function setCurrency(country) {
			const prices = {
				AE: {
					product: '800.00',
					addons: ['600.00', '400.00', '400.00', '400.00'],
					addonTexts: [
						'Add Notarization::300.00',
						'Add Translation::400.00',
						'Add Certified Copy of Passport/ID::400.00',
						'Express Service::400.00'
					]
				},
				GBP_EUR: {
					product: '180.00',
					addons: ['80.00', '70.00', '60.00', '60.00'],
					addonTexts: [
						'Add Notarization::80.00',
						'Add Translation::70.00',
						'Add Certified Copy of Passport/ID::60.00',
						'Express Service::60.00'
					]
				},
				DEFAULT: {
					product: '180.00',
					addons: ['80.00', '70.00', '60.00', '60.00'],
					addonTexts: [
						'Add Notarization::80.00',
						'Add Translation::70.00',
						'Add Certified Copy of Passport/ID::60.00',
						'Express Service::60.00'
					]
				}
			};

			let priceSet;
			let currencySymbol = "\u0024";
			let currencyCode = "USD";

			if (country === 'AE') {
				priceSet = prices.AE;
				currencySymbol = "AED ";
				currencyCode = "AED";
			} else if (country === 'GB') {
				priceSet = prices.GBP_EUR;
				currencySymbol = "\u00A3";
				currencyCode = "GBP";
			} else if (country !== '' && country !== 'US' && country !== 'IN') {
				priceSet = prices.GBP_EUR;
				currencySymbol = "\u20AC";
				currencyCode = "EUR";
			} else {
				priceSet = prices.DEFAULT;
			}

			product = priceSet.product;

			$('[name="addon_values"]').each(function(index) {
				if (priceSet.addonTexts[index]) {
					$(this).val(priceSet.addonTexts[index]);
					$(this).parent().parent().find('.addon-price').text(priceSet.addons[index]);
				}
			});

			 
			selectedcurrency = currencySymbol;
			$("#currencyCode").val(currencyCode);
			$(".currencySymbol").text(currencySymbol);
			$("#currencySymbol").val(currencySymbol.trim());
			$("#productprice").text(product);
			$("#productTotal").text(product);
			updateTotal();
			 
		}


		function loadPaymentKeys() {
			$.ajax({
				url : 'paykeys',
				type : 'GET',
				success : function(data) {

				},
				failure : function(data) {
					console.log(data);
				}
			});
		}

		$(document).ready(
				function() {
					$(".faq-question").on(
							"click",
							function() {
								var $this = $(this);
								var target = $this.data("bs-target");
								if ($(target).hasClass("show")) {
									$(target).collapse('hide');
									$this.removeClass("active");
									$this.find("i").removeClass("fa-angle-up")
											.addClass("fa-angle-down");
								} else {
									$(".faq-question").removeClass("active")
											.find("i").removeClass(
													"fa-angle-up").addClass(
													"fa-angle-down");
									$(".collapse.show").collapse('hide');
									$this.addClass("active");
									$(target).collapse('show');
									$this.find("i")
											.removeClass("fa-angle-down")
											.addClass("fa-angle-up");
								}
							});
					$('.imageContainer').slick({
						slidesToShow : 4,
						slidesToScroll : 1,
						infinite : true,
						arrows : false,
						dots : true,
						autoplay : true,
						autoplaySpeed : 2000,
						centerMode : false,
						responsive : [ {
							breakpoint : 768,
							settings : {
								slidesToShow : 2
							}
						}, {
							breakpoint : 480,
							settings : {
								slidesToShow : 1
							}
						} ]
					});
					$('.testimonial-carousel').slick({
						slidesToShow : 1,
						slidesToScroll : 1,
						infinite : true,
						arrows : false,
						dots : true,
						autoplay : true,
						autoplaySpeed : 2000,
						centerMode : false,
						responsive : [ {
							breakpoint : 768,
							settings : {
								slidesToShow : 2
							}
						}, {
							breakpoint : 480,
							settings : {
								slidesToShow : 1
							}
						} ]
					});
					initializeMobileSlider();
				});
		var swiper = new Swiper(".mySwiper", {
			slidesPerView : 3,
			slidesPerGroup : 3,
			spaceBetween : 10,
			loop : true,
			loopAdditionalSlides : 3, // important for loop + group combo
			autoplay : {
				delay : 2000,
				disableOnInteraction : false,
			},
			speed : 600,
			breakpoints : {
				1024 : {
					slidesPerView : 3,
					slidesPerGroup : 3,
				},
				768 : {
					slidesPerView : 2,
					slidesPerGroup : 2,
				},
				480 : {
					slidesPerView : 1,
					slidesPerGroup : 1,
				}
			}
		});

		$('.collapse').on(
				'shown.bs.collapse',
				function() {
					var question = $(this).prev('.faq-question');
					question.find("i").removeClass("fa-angle-down").addClass(
							"fa-angle-up");
				});

		$('.collapse').on(
				'hidden.bs.collapse',
				function() {
					var question = $(this).prev('.faq-question');
					question.find("i").removeClass("fa-angle-up").addClass(
							"fa-angle-down");
				});
		$(window).on('resize', function() {
			initializeMobileSlider();
		});
		function initializeMobileSlider() {
			if ($(window).width() < 768) {
				if (!$('.testimonial-carousel').hasClass('slick-initialized')) {
					$('.testimonial-carousel').slick({
						slidesToShow : 1,
						slidesToScroll : 1,
						infinite : true,
						arrows : false,
						dots : true,
						autoplay : true,
						autoplaySpeed : 2000,
						centerMode : false
					});
				}
			} else {
				if ($('.testimonial-carousel').hasClass('slick-initialized')) {
					$('.testimonial-carousel').slick('unslick');
				}
			}
		}
	</script>

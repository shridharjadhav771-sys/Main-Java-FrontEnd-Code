	<script>
		var selectedcurrency = "$";
		$(function() {
			loadPaymentKeys();
			$.get("https://ipinfo.io", function(response) {
				var userCountry = response.country;
				//getCurrencyByCountry(userCountry, defaultCurrency);
				//console.log(response.city, response.country);
				$("#country").val(response.country);
				$("#userIp").val(response.ip);
				setCurrency(response.country);
			}, "jsonp");

		});
	</script>
	<script type="text/javascript">
		document
				.addEventListener(
						"DOMContentLoaded",
						function() {
							let total = 0;
							let subtotal = parseFloat(document
									.getElementById("subtotal").innerText
									.replace(/[^\d.]/g, ''));
							let product = parseFloat(document
									.getElementById("productTotal").innerText
									.replace(/[^\d.]/g, ''));
							let shippingcharges = parseFloat($(
									'[name="shipping_method"]:checked').next()
									.find(".charges").text().replace(/[^\d.]/g,
											''));
							document.getElementById("totalPrice").innerText = (total
									+ product + shippingcharges).toFixed(2);
							$("#orderCost").val(
									(total + product + shippingcharges)
											.toFixed(2));
							let orderCostRound = ((total + product + shippingcharges)
									.toFixed(2)) * 100;
							$("#orderCostRound").val(orderCostRound);
							function updateTotal() {
								total = 0;
								let checkboxes = document
										.querySelectorAll('.addon-option:checked');
								checkboxes.forEach(function(checkbox) {
									total += parseFloat(checkbox.value
											.split("::")[1]);
								});
								let shipping = $(
										'[name="shipping_method"]:checked')
										.next().find(".charges").text()
										.replace(/[^\d.]/g, '')
								document.getElementById("subtotal").innerText = (total + product)
										.toFixed(2);
								let charges = parseFloat($(
										'[name="shipping_method"]:checked')
										.next().find(".charges").text()
										.replace(/[^\d.]/g, ''));
								document.getElementById("totalPrice").innerText = (total
										+ product + charges).toFixed(2);
								$("#orderCost").val(
										(total + product + shippingcharges)
												.toFixed(2));
								let orderCostRound = ((total + product + shippingcharges)
										.toFixed(2)) * 100;
								$("#orderCostRound").val(orderCostRound);
							}

							document.querySelectorAll(".addon-option").forEach(
									function(input) {
										input.addEventListener("change",
												updateTotal);
									});
							$('[name="shipping_method"]').change(function() {
								updateTotal();
							});
						});

		function setCurrency(country) {
			var currencySymbol = "\u0024";
			var currencyCode = "USD";

			if (country === 'GB') {
				currencySymbol = "\u00A3";
				currencyCode = "GBP";
			} else if (country !== '' && country !== 'US' && country !== 'IN') {
				currencySymbol = "\u20AC";
				currencyCode = "EUR";
			}
			selectedcurrency = currencySymbol;
			$("#currencyCode").val(currencyCode);
			$(".currencySymbol").text(currencySymbol);
			$("#currencySymbol").val(currencySymbol);
		}

		function loadPaymentKeys() {
			$.ajax({
				url : 'paykeys',
				type : 'GET',
				success : function(data) {

				},
				failure : function(data) {
					console.log(data);
				}
			});
		}

		$(document).ready( function() {
			 const items = document.querySelectorAll('.accordion-item');

			    items.forEach(item => {
			      const title = item.querySelector('.accordion-title');
			      title.addEventListener('click', () => {
			        items.forEach(i => {
			          if (i !== item) i.classList.remove('active');
			        });
			        item.classList.toggle('active');
			      });
			    });
			
					/* initializeMobileSlider(); */
				});
	

		/* $(window).on('resize', function() {
			initializeMobileSlider();
		});
		function initializeMobileSlider() {
			if ($(window).width() < 768) {
				if (!$('.testimonial-carousel').hasClass('slick-initialized')) {
					$('.testimonial-carousel').slick({
						slidesToShow : 1,
						slidesToScroll : 1,
						infinite : true,
						arrows : false,
						dots : true,
						autoplay : true,
						autoplaySpeed : 2000,
						centerMode : false
					});
				}
			} else {
				if ($('.testimonial-carousel').hasClass('slick-initialized')) {
					$('.testimonial-carousel').slick('unslick');
				}
			}
		} */
		window.addEventListener('DOMContentLoaded', function () {
		    if (window.location.hash && document.querySelector(window.location.hash)) {
		      const target = document.querySelector(window.location.hash);
		      target.style.display = 'none';
		      history.replaceState(null, null, ' ');
		      setTimeout(() => {
		        target.style.display = '';
		      }, 50); 
		    }
		  });
		document.addEventListener("DOMContentLoaded", () => {
			  const counters = document.querySelectorAll(".counter-number");

			  counters.forEach(counter => {
			    const target = parseFloat(counter.dataset.target);
			    const suffix = counter.dataset.suffix || "";
			    const format = counter.dataset.format || "normal";
			    let current = 0;
			    const totalSteps = 100;
			    let step = 0;

			    function easeOut(t) {
			      return 1 - Math.pow(1 - t, 3);
			    }

			    function updateCounter() {
			      step++;
			      const progress = step / totalSteps;
			      const easedProgress = easeOut(progress);
			      current = target * easedProgress;

			      if (step < totalSteps) {
			        counter.innerText = formatNumber(current, format) + suffix;
			        requestAnimationFrame(updateCounter);
			      } else {
			        counter.innerText = formatNumber(target, format) + suffix;
			      }
			    }

			    function formatNumber(num, format) {
			      if (format === "decimal") return num.toFixed(1);
			      if (format === "short") return Math.floor(num); // just return number, no 'k'
			      return Math.floor(num);
			    }

			    updateCounter();
			  });
			});
		 
		
		  var customTrack = document.getElementById('custom-track');
		  var customSlides = document.querySelectorAll('.custom-carousel-slide');
		  var customCardWidth = customSlides[0].offsetWidth;
		  var customIndex = 0;

		  function customSlideTo(newIndex) {
		    customTrack.style.transition = 'transform 0.5s ease-in-out';
		    customTrack.style.transform = 'translateX(-' + (newIndex * customCardWidth) + 'px)';
		    customIndex = newIndex;

		    if (customIndex === customSlides.length - 3) {
		      setTimeout(function() {
		        customTrack.style.transition = 'none';
		        customTrack.style.transform = 'translateX(0)';
		        customIndex = 0;
		      }, 500);
		    }
		  }

		  function customNextSlide() {
		    customSlideTo(customIndex + 1);
		    resetCustomAutoplay();
		  }

		  function customPrevSlide() {
		    customIndex = customIndex - 1 < 0 ? customSlides.length - 4 : customIndex - 1;
		    customTrack.style.transition = 'none';
		    customTrack.style.transform = 'translateX(-' + (customIndex * customCardWidth) + 'px)';
		    setTimeout(function() {
		      customTrack.style.transition = 'transform 0.5s ease-in-out';
		    }, 20);
		    resetCustomAutoplay();
		  }

		  function autoCustomSlide() {
		    customSlideTo(customIndex + 1);
		  }

		  var customAutoplay = setInterval(autoCustomSlide, 3000); 

		  function resetCustomAutoplay() {
		    clearInterval(customAutoplay);
		    customAutoplay = setInterval(autoCustomSlide, 3000);
		  }

		  window.addEventListener('resize', function() {
		    customCardWidth = customSlides[0].offsetWidth;
		    customTrack.style.transition = 'none';
		    customTrack.style.transform = 'translateX(-' + (customIndex * customCardWidth) + 'px)';
		  });
	</script>

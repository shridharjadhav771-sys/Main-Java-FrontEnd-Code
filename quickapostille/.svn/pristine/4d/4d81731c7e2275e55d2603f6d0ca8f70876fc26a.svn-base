<%
String orderId = request.getParameter("id") == null ? "" : request.getParameter("id");
%>
<body>
	<!-- Google Tag Manager (noscript) -->
	<noscript>
		<iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WSFP6M7W"
			height="0" width="0" style="display: none; visibility: hidden"></iframe>
	</noscript>
	<!-- End Google Tag Manager (noscript) --> 
	<div class="container top-bar d-flex p-2">
		<div class="col-4 col-sm-0 text-start d-none d-sm-block">
			<strong><img class="alignnone" src="images/mail-1.png"
				alt="mail" width="24" height="24">&nbsp;&nbsp;<span
				style="color: #203852">contact@quickapostille.online</span></strong>
		</div>

		<div class="col-md-3 col-sm-12 text-center">
			<!-- <strong><img class="alignnone" src="images/phone 2-01.png"
				alt="phone" width="24" height="24">&nbsp;&nbsp; <span href="#"
				style="color: #203852; text-decoration: none">+1(252) 579
					0347</span></strong> -->
		</div>

		<div class="col-5 col-sm-0  text-end  d-none d-sm-block">
			<span style="color: #203852"><strong> <img
					class="alignnone"
					src="images/WXibs0O8_400x400-removebg-preview-300x300.png" alt=""
					width="29" height="29">Official HCCH Hague Convention
					Documentation
			</strong></span>
		</div>
	</div>

	<!-- Navigation-->
	<%@ include file="nav.jsp"%>

	<section class="mt-5">

		<div class="container">
			<div class="row text-center">
				<div class="col-12 text-center">
					<img style="width: 200px" src="images/id-check.png" alt="id-check">
				</div>
			</div>
			<%
			String id = request.getParameter("id");
			String isfile = request.getParameter("isfile");
			if (id != null && isfile != null && isfile.equals("0")) {
			%>
			
			<div class="row mt-4">
				<div class="col-md-1 com-sm-0"></div>
				<div class="col-md-10 com-sm-12">					
					<div class="text-center">
						<h2>Thank you for using Quick Apostille!</h2>
						 
					</div>
				</div>
				<div class="col-md-1 com-sm-0"></div>

			</div>
			
			<div class="row mt-4">
				<div class="col-md-1 com-sm-0"></div>
				<div class="col-md-10 com-sm-12 text-center">
					<h3>Step 1: Upload Your Apostille/Notary Documents</h3>
					<form id="uploadFileForm" enctype="multipart/form-data">
					<input name = "orderid" value = "<%= id%>" hidden>
						<div class="row">
							<fieldset id="drop_zone"
								class="upload_dropZone text-center mb-3 p-4">
								<legend class="visually-hidden">Image uploader</legend>

								<input id="upload_image_background"
									name="upload_image_background"
									class="position-absolute invisible" type="file" multiple
									accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.ppt,.pptx,.odt" /> <label
									class="btn btn-upload mb-3" for="upload_image_background">
									<svg xmlns="http://www.w3.org/2000/svg" width="32" height="33"
										fill="none">
						        <mask id="a" style="mask-type:alpha"
											maskUnits="userSpaceOnUse" x="0" y="0" width="32" height="33">
						          <path fill="#D9D9D9" d="M0 .203h32v32H0z" />
						        </mask>
						        <g mask="url(#a)">
						          <path
											d="M8.41 26.203a2.327 2.327 0 0 1-1.71-.7 2.327 2.327 0 0 1-.7-1.71v-2.616c0-.284.096-.521.287-.712A.967.967 0 0 1 7 20.177c.284 0 .521.096.713.288a.967.967 0 0 1 .287.712v2.616c0 .102.043.196.128.282.086.085.18.128.282.128h15.18a.392.392 0 0 0 .282-.128.392.392 0 0 0 .128-.282v-2.616c0-.284.096-.521.287-.712a.967.967 0 0 1 .713-.288c.284 0 .521.096.713.288a.967.967 0 0 1 .287.712v2.616c0 .673-.233 1.243-.7 1.71-.467.467-1.037.7-1.71.7H8.41ZM15 10.054l-2.564 2.564a.953.953 0 0 1-.706.294 1.002 1.002 0 0 1-.72-.314 1.044 1.044 0 0 1-.3-.703c-.007-.261.093-.495.3-.702l4.146-4.146A1.103 1.103 0 0 1 16 6.706a1.103 1.103 0 0 1 .844.341l4.146 4.146a.94.94 0 0 1 .293.696c-.002.266-.1.502-.293.709a1.02 1.02 0 0 1-.713.32.944.944 0 0 1-.713-.3L17 10.054v10.2a.967.967 0 0 1-.287.713.967.967 0 0 1-.713.287.967.967 0 0 1-.713-.287.967.967 0 0 1-.287-.713v-10.2Z"
											fill="#212529" />
							        </g>
							      </svg>
								</label>

								<h1 class="h4 text-center mb-3">Select or Drag Drop File</h1>

								<p class="small my-3">
									Allowed Extensions: <strong>jpg, jpeg, png, pdf, doc,
										docx, ppt, pptx, odt</strong><br> Maximum Upload Filesize: <strong>50MB</strong>
								</p>

								<div id="upload_error" class="text-danger mb-2"
									style="display: none;"></div>
									<div id="upload_msg" class="text-success mb-2"
									style="display: none;"></div>
								<div
									class="upload_gallery d-flex flex-wrap justify-content-center gap-3 mb-0"></div>
									
								<button class="btn btn-lg w-100 mt-3 mb-3" type="submit" id="uploadfile">Upload File</button>
							</fieldset>

						</div>
					</form>

				</div>
				<div class="col-md-1 com-sm-0"></div>
			</div>
			<div class="horizontalLine"></div>
			<div class="row mt-4">
				<div class="col-md-1 com-sm-0"></div>
				<div class="col-md-10 com-sm-12">					
					<div class="text-center">
						 
						<div class="row mt-3">

							<h3>Step 2: Verify Your ID</h3>
							<p class="mt-2">
								In order to submit your order for processing it will be required
								to verify your ID.<br />Please complete the verification
								process please click below button.
							</p>
						</div>
						<div class="row mt-3 mb-5 ">
							<div class="col-12 text-center">
								<button class="btn btn-lg w-100 mt-3 mb-3 btn-main" type="button" onclick="startVerification()"><i class="fa fa-id-card"
									aria-hidden="true"></i>&nbsp;&nbsp;VERIFY ME</button>
								 
							</div>

						</div>
					</div>
				</div>
				<div class="col-md-1 com-sm-0"></div> 
			</div> 
			<%
			}else{
			%> 
			<div class="row mt-4">
				<div class="col-md-1 com-sm-0"></div>
				<div class="col-md-10 com-sm-12">					
					<div class="text-center">
						<h2>Thank you for using Quick Apostille!</h2>
						<div class="row mt-5"> 
							<h3>Verify Your ID</h3>
							<p class="mt-2">
								In order to submit your order for processing it will be required
								to verify your ID.<br />Please complete the verification
								process please click below button.
							</p>
						</div>
						<div class="row mt-3 mb-5 ">
							<div class="col-12 text-center">
								<button class="btn btn-lg w-100 mt-3 mb-3 btn-main" type="button" onclick="startVerification()"><i class="fa fa-id-card"
									aria-hidden="true"></i>&nbsp;&nbsp;VERIFY ME</button>
							</div>

						</div>
					</div>
				</div>
				<div class="col-md-1 com-sm-0"></div> 
			</div>
			<%} %> 
		</div> 
	</section> 
	<!-- Footer--> 
	<%@ include file="footer.jsp"%>
	<!-- Bootstrap core JS-->
	<script
		src="https://ajax.googleapis.com/ajax/libs/jquery/1.7.1/jquery.min.js"
		type="text/javascript"></script>
	<script src="https://web-button.metamap.com/button.js"> </script>
	<script type="text/javascript">
	$(document).ready(function(){
		let id = '<%= id != null ? id : "" %>';
		if (id !== "") {
			getUploadedFileName(id);
		}
	});
	const configuration = {
			  clientId: "67c0af7d8ef66ecb0db967a2",
			  flowId: "67c0af7d8ef66e5104b967a1",
			  metadata: {
					order_id: '<%=orderId%>',
				},
			};
	const verification = new MetamapVerification(configuration);
	verification.on('metamap:userStartedSdk', ({ detail }) => {
		  console.log('started payload', detail)
	});
	
	verification.on('metamap:userFinishedSdk', ({ detail }) => {
	  console.log('finished payload', detail);
	  $("#exitedSdkId").css("display", "none");
	  $("#successSdkId").css("display", "block");
	});
	verification.on('metamap:exitedSdk', ({ detail }) => {
		  console.log('exidet payload', detail);
		  $("#exitedSdkId").css("display", "block");
	});
	
	 
	
	function startVerification(){
		verification.start();
	}
	var form = document.querySelector('#uploadFileForm'); 
	form.addEventListener('submit', function(e) {
		 e.preventDefault(); 
		 let isValid = true; 
		// File validation
		 const fileInput = document.getElementById("upload_image_background");
		 const allowedExtensions = ['jpg', 'jpeg', 'png', 'pdf', 'doc', 'docx', 'ppt', 'pptx', 'odt'];
		 const maxFileSize = 50 * 1024 * 1024; // 50MB
		 const errorBox = document.querySelector('#upload_error');

		 if (fileInput) {
		     if (fileInput.files.length === 0) {
		         showError('Please select a file to upload.');
		         isValid = false;
		     } else {
		         const file = fileInput.files[0];
		         const ext = file.name.split('.').pop().toLowerCase();

		         if (!allowedExtensions.includes(ext)) {
		             showError('Invalid file type: ' + file.name);
		             isValid = false;
		         } else if (file.size > maxFileSize) {
		             showError('File size exceeds 50MB: ' + file.name);
		             isValid = false;
		         } else {
		             if (errorBox) errorBox.style.display = 'none';
		         }
		     }
		 }

		if(isValid){
			let formData = new FormData(document.getElementById("uploadFileForm"));
			$.ajax({
		        url: 'uploadcustomerdocuments',
		        type: 'POST',
		        data: formData,
		        contentType: false,
		        processData: false,
		        success: function(response) { 
		            if(response){
		            	$("#upload_msg").show().text("File uploaded successfully!");
		            }
		        },
		        error: function(error) {
		        	 console.log(error);
		        } 
			});
			
		}
	})
	function getUploadedFileName(id){
		$.ajax({
	        url: 'uploadcustomerdocuments',
	        type: 'GET',
	        data: {
	        	orderid : id,
	        },
	        success: function(response) { 
				if(response != "" && response != null){
					$(".upload_gallery").html('<div class="p-2 border rounded"><strong>'+response+'</strong></div>');
				}
	            
	        },
	        error: function(error) {
	        	 console.log(error);
	        } 
		});
	}
	function showError(msg) {
	    const errorBox = document.querySelector('#upload_error');
	    if (errorBox) {
	        errorBox.innerText = msg;
	        errorBox.style.display = 'block';
	    }
	}
	 const dropZone = document.getElementById('drop_zone');
	  const fileInput = document.getElementById('upload_image_background');
	  const uploadError = document.getElementById('upload_error');
	  const gallery = document.querySelector('.upload_gallery');

	  // Prevent default drag behaviors
	  ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
	    dropZone.addEventListener(eventName, e => {
	      e.preventDefault();
	      e.stopPropagation();
	    });
	  });
	  ['dragenter', 'dragover'].forEach(eventName => {
	    dropZone.addEventListener(eventName, () => {
	      dropZone.classList.add('highlight');
	    });
	  });
	  ['dragleave', 'drop'].forEach(eventName => {
	    dropZone.addEventListener(eventName, () => {
	      dropZone.classList.remove('highlight');
	    });
	  });

	  dropZone.addEventListener('drop', e => {
	    const files = e.dataTransfer.files;
	    fileInput.files = files; 
	    handleFiles(files);
	  });

	  fileInput.addEventListener('change', () => {
	    handleFiles(fileInput.files);
	  });

	  function handleFiles(files) {
	    uploadError.style.display = 'none';
	    gallery.innerHTML = '';

	    Array.from(files).forEach(file => {
	      if (file.size > 50 * 1024 * 1024) { 
	        uploadError.textContent = 'File '+file.name+' exceeds 50MB limit.';
	        uploadError.style.display = 'block';
	        return;
	      }

	      const ext = file.name.split('.').pop().toLowerCase();
	      const allowedExts = ['jpg', 'jpeg', 'png', 'pdf', 'doc', 'docx', 'ppt', 'pptx', 'odt'];
	      if (!allowedExts.includes(ext)) {
	        uploadError.textContent = 'File '+file.name+' has unsupported format.';
	        uploadError.style.display = 'block';
	        return;
	      }

	      const preview = document.createElement('div');
	      preview.classList.add('p-2', 'border', 'rounded');
	      preview.innerHTML = '<strong>' + file.name + '</strong> (' + (file.size / 1024).toFixed(1) + ' KB)';
	      gallery.appendChild(preview);
	    });
	  }
	</script>
	<script async data-id="101481203" src="//static.getclicky.com/js"></script> 
<noscript>
	<p>
		<img alt="Clicky" width="1" height="1"
			src="//in.getclicky.com/101481203ns.gif" />
	</p>
</noscript>

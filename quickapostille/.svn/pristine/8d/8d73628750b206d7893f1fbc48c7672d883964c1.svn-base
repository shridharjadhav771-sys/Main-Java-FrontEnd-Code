	<section id="headerImageSection">

		<div class=" d-flex justify-content-center">
			<div class="seprator"></div>
			<h1 class="d-flex justify-content-center mt-5">FAQ</h1>

		</div>
	</section>


	<section id="asked_questions_section">
		<div class="container">
			<h2 class="mb-4 ps-3 d-flex justify-content-center">Frequently
				Asked Questions</h2>
			<div class="accordion" id="faqAccordion">

				<!-- FAQ Item 1 -->
				<div class="mb-1">
					<div class="faq-question p-3 active" data-bs-toggle="collapse"
						data-bs-target="#faq1">
						What is an Apostille? <i class="fa fa-angle-up"
							aria-hidden="true"></i>
					</div>
					<div id="faq1" class="collapse mt-2 show">
						<div class="p-3 ">An Apostille is a certification that
							verifies the authenticity of a document for use in countries that
							are part of the Hague Apostille Convention.</div>
					</div>
				</div>
				<div class="mb-1">
					<div class="faq-question p-3" data-bs-toggle="collapse"
						data-bs-target="#faq2">
						What is the difference between Apostille and Notarization? <i
							class="fa fa-angle-down" aria-hidden="true"></i>
					</div>
					<div id="faq2" class="collapse mt-2">
						<div class="p-3 ">Notarization confirms the authenticity of
							a signature on a document, while an Apostille certifies the
							document for international use.</div>
					</div>
				</div>
				<div class="mb-1">
					<div class="faq-question p-3" data-bs-toggle="collapse"
						data-bs-target="#faq3">
						Which documents can be apostilled? <i class="fa fa-angle-down"
							aria-hidden="true"></i>
					</div>
					<div id="faq3" class="collapse mt-2">
						<div class="p-3 ">Common documents include birth
							certificates, marriage certificates, diplomas, power of attorney,
							and business agreements.</div>
					</div>
				</div>
				<div class="mb-1">
					<div class="faq-question p-3" data-bs-toggle="collapse"
						data-bs-target="#faq4">
						How long does the Apostille process take?<i
							class="fa fa-angle-down" aria-hidden="true"></i>
					</div>
					<div id="faq4" class="collapse mt-2">
						<div class="p-3 ">Processing times vary by jurisdiction but
							typically range from a few hours to several business days.</div>
					</div>
				</div>
				<div class="mb-1">
					<div class="faq-question p-3" data-bs-toggle="collapse"
						data-bs-target="#faq5">
						Do I need notarization before getting an Apostille? <i
							class="fa fa-angle-down" aria-hidden="true"></i>
					</div>
					<div id="faq5" class="collapse mt-2">
						<div class="p-3 ">Some documents require notarization before
							Apostille, depending on the type and issuing authority.</div>
					</div>
				</div>
				<div class="mb-1">
					<div class="faq-question p-3" data-bs-toggle="collapse"
						data-bs-target="#faq6">
						Is an Apostille valid worldwide?<i class="fa fa-angle-down"
							aria-hidden="true"></i>
					</div>
					<div id="faq6" class="collapse mt-2">
						<div class="p-3 ">Apostilles are valid only in countries
							that are members of the Hague Apostille Convention.</div>
					</div>
				</div>
				<div class="mb-1">
					<div class="faq-question p-3" data-bs-toggle="collapse"
						data-bs-target="#faq6">
						What if my destination country is not part of the Hague
						Convention?<i class="fa fa-angle-down" aria-hidden="true"></i>
					</div>
					<div id="faq6" class="collapse mt-2">
						<div class="p-3 ">If the country is not a member, you may
							need embassy legalization instead of an Apostille.</div>
					</div>
				</div>
				<div class="mb-1">
					<div class="faq-question p-3" data-bs-toggle="collapse"
						data-bs-target="#faq6">
						Can I get an Apostille for electronic documents?<i
							class="fa fa-angle-down" aria-hidden="true"></i>
					</div>
					<div id="faq6" class="collapse mt-2">
						<div class="p-3 ">Some jurisdictions allow e-Apostilles for
							electronically signed documents.</div>
					</div>
				</div>
				<div class="mb-1">
					<div class="faq-question p-3" data-bs-toggle="collapse"
						data-bs-target="#faq6">
						Where can I get an Apostille?<i class="fa fa-angle-down"
							aria-hidden="true"></i>
					</div>
					<div id="faq6" class="collapse mt-2">
						<div class="p-3 ">Apostilles are issued by designated
							government authorities, such as the Secretary of State or
							Ministry of Foreign Affairs.</div>
					</div>
				</div>
				<div class="mb-1">
					<div class="faq-question p-3" data-bs-toggle="collapse"
						data-bs-target="#faq6">
						Do I need to be present for Apostille or Notarization?<i
							class="fa fa-angle-down" aria-hidden="true"></i>
					</div>
					<div id="faq6" class="collapse mt-2">
						<div class="p-3 ">Notarization usually requires in-person
							verification, but Apostille processing can often be done by mail
							or through a service provider.</div>
					</div>
				</div>


				<!-- Add more FAQ items similarly -->

			</div>
		</div>
	</section>

	<section id="getStarted-section" class="d-flex justify-content-center">

		<div>
			<div>

				<div>
					<h2 class="getStarted d-flex justify-content-center">Get
						Started Today !</h2>
				</div>
				<p class="getStarted-p">
					Simplify your document authentication with our Quick and secure
					service.<br> Quick Processing | Secure & Verified | Legally
					Compliant
				</p>
			</div>
			<div class="d-flex justify-content-center">
				<a class="btn" href="contact.jsp" role="button"><span
					id="contact_btn_span-faq">Contact Us</span></a>
			</div>
		</div> 
	</section>


	<!-- Footer-->


	<%@ include file="footer.jsp"%>
	<!-- Bootstrap core JS-->
	<script
		src="https://ajax.googleapis.com/ajax/libs/jquery/1.7.1/jquery.min.js"
		type="text/javascript"></script>
	<script
		src="//cdnjs.cloudflare.com/ajax/libs/select2/4.0.3/js/select2.full.js"></script>

	<script src="js/bootstrap.bundle.min.js"></script>

	<script
		src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
	<script type="text/javascript"
		src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
<script type="text/javascript">

$(document).ready(
		function() {
			$(".faq-question").on("click",function() {
						var $this = $(this);
						var target = $this.data("bs-target");
						if ($(target).hasClass("show")) {
							$(target).collapse('hide');
							$this.removeClass("active");
							$this.find("i").removeClass("fa-angle-up").addClass("fa-angle-down");
						} else {
							$(".faq-question").removeClass("active")
									.find("i").removeClass(
											"fa-angle-up").addClass(
											"fa-angle-down");
							$(".collapse.show").collapse('hide');
							$this.addClass("active");
							$(target).collapse('show');
							$this.find("i").removeClass("fa-angle-down").addClass("fa-angle-up");
							
						}
					});
		});



$('.collapse').on('shown.bs.collapse',function() {
			var question = $(this).prev('.faq-question');
			question.find("i").removeClass("fa-angle-down").addClass("fa-angle-up");
		});
		
		

$('.collapse').on('hidden.bs.collapse',function() {
			var question = $(this).prev('.faq-question');
			question.find("i").removeClass("fa-angle-up").addClass("fa-angle-down");
		});
</script>


</body>
</html>
